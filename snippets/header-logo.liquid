{%- comment -%}
  Renders the header logo while preserving the theme logo and shop name fallbacks.

  Accepts:
  - logo_url: the preferred hosted logo URL
  - motion_reduce: adds Dawn's reduced-motion class when true
{%- endcomment -%}

{%- if logo_url != blank -%}
  <div class="header__heading-logo-wrapper header__heading-logo-wrapper--elix">
    <img
      src="{{ logo_url }}"
      class="header__heading-logo header__heading-logo--elix{% if motion_reduce %} motion-reduce{% endif %}"
      alt="ELIX LABS"
      loading="eager"
      fetchpriority="high"
    >
  </div>
{%- elsif settings.logo != blank -%}
  <div class="header__heading-logo-wrapper">
    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
    {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
    {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
    {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
    {{
      settings.logo
      | image_url: width: 600
      | image_tag:
        class: 'header__heading-logo',
        widths: widths,
        height: logo_height,
        width: settings.logo_width,
        alt: logo_alt,
        sizes: sizes,
        preload: true
    }}
  </div>
{%- else -%}
  <span class="h2">{{ shop.name }}</span>
{%- endif -%}
