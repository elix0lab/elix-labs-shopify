        "faq_0": {
          "type": "faq",
          "settings": {
            "question": "What is GHK-Cu?",
            "answer": "<p>GHK-Cu is a naturally occurring tripeptide, glycyl-L-histidyl-L-lysine, complexed with copper. It is studied as a biochemical research compound rather than an approved medicine.</p>"
          }
        },
        "faq_1": {
          "type": "faq",
          "settings": {
            "question": "What does the “Cu” in GHK-Cu represent?",
            "answer": "<p>“Cu” is the chemical symbol for copper. In GHK-Cu, the peptide coordinates a copper ion, a feature relevant to its experimentally investigated biological interactions.</p>"
          }
        },
        "faq_2": {
          "type": "faq",
          "settings": {
            "question": "How is GHK-Cu studied in laboratory research?",
            "answer": "<p>Researchers examine GHK-Cu in biochemical assays, cell cultures and preclinical models to investigate matrix remodelling, fibroblast behaviour, repair signalling and follicle biology. Such findings do not establish clinical efficacy.</p>"
          }
        },
        "faq_3": {
          "type": "faq",
          "settings": {
            "question": "Which biological mechanisms are associated with GHK-Cu?",
            "answer": "<p>Research associates GHK-Cu with extracellular-matrix turnover, collagen and elastin organisation, selected inflammatory and antioxidant pathways, angiogenic signalling and tissue-regeneration processes.</p>"
          }
        },
        "faq_4": {
          "type": "faq",
          "settings": {
            "question": "How should lyophilized GHK-Cu be stored for research?",
            "answer": "<p>Keep the sealed lyophilized material refrigerated at 2–8°C, dry and protected from light. Follow the batch documentation and the laboratory’s validated handling procedures.</p>"
          }
        },
        "faq_5": {
          "type": "faq",
          "settings": {
            "question": "Is GHK-Cu intended for human use?",
            "answer": "<p>No. This product is supplied for laboratory research only and is not intended for human or veterinary use, diagnosis, treatment or consumption.</p>"
          }
        },
        "faq_6": {
          "type": "faq",
          "settings": {
            "question": "Does GHK-Cu have the same research profile as BPC-157?",
            "answer": "<p>No. They are distinct compounds with different structures and research profiles. Evidence or proposed mechanisms for one should not be applied to the other.</p>"
          }
        },
