        "faq_0": {
          "type": "faq",
          "settings": {
            "question": "What is Ipamorelin?",
            "answer": "<p>Ipamorelin is a synthetic pentapeptide studied as a growth-hormone secretagogue and selective agonist of GHS-R1a. ELIX LABS supplies it exclusively as an experimental research compound.</p>"
