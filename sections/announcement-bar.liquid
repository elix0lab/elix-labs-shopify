{%- if section.settings.enabled and section.blocks.first.settings.text != blank -%}
  {%- assign announcement = section.blocks.first -%}
  <div class="elix-announcement" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ announcement.shopify_attributes }}>
    {%- if announcement.settings.link != blank -%}<a class="elix-announcement__link focus-inset" href="{{ announcement.settings.link }}">{%- endif -%}
      <div class="elix-announcement__viewport{% unless section.settings.animate %} elix-announcement__viewport--static{% endunless %}">
        <div class="elix-announcement__track" style="--elix-marquee-duration: {{ section.settings.speed }}s;">
          <span class="elix-announcement__group">
            <span class="elix-announcement__message">{{ announcement.settings.text | escape }}</span>
            <span class="elix-announcement__message" aria-hidden="true">{{ announcement.settings.text | escape }}</span>
          </span>
          {%- if section.settings.animate -%}
            <span class="elix-announcement__group" aria-hidden="true">
              <span class="elix-announcement__message">{{ announcement.settings.text | escape }}</span>
              <span class="elix-announcement__message">{{ announcement.settings.text | escape }}</span>
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- if announcement.settings.link != blank -%}</a>{%- endif -%}
  </div>

  <style>
    .elix-announcement { overflow: hidden; color: #f3f6ff; background: linear-gradient(105deg, #050811 0%, #0a1020 48%, #120d24 100%); border-bottom: 1px solid rgba(116, 128, 255, .42); box-shadow: 0 3px 18px rgba(62, 79, 190, .14); }
    .elix-announcement__link { display: block; color: inherit; text-decoration: none; }
    .elix-announcement__viewport { width: 100%; overflow: hidden; }
    .elix-announcement__track { display: flex; width: max-content; will-change: transform; animation: elix-announcement-scroll var(--elix-marquee-duration) linear infinite; }
    .elix-announcement__group { display: flex; flex-shrink: 0; }
    .elix-announcement__message { flex-shrink: 0; padding: .85rem 2.4rem; font-size: 1.15rem; font-weight: 600; line-height: 1.2; letter-spacing: .09em; white-space: nowrap; }
    .elix-announcement__viewport--static .elix-announcement__track { width: 100%; animation: none; }
    .elix-announcement__viewport--static .elix-announcement__group { min-width: 100%; overflow-x: auto; }
    .elix-announcement__viewport--static .elix-announcement__message[aria-hidden] { display: none; }
    @keyframes elix-announcement-scroll { to { transform: translateX(-50%); } }
    @media screen and (max-width: 749px) { .elix-announcement__message { padding: .75rem 1.8rem; font-size: 1.05rem; letter-spacing: .07em; } }
    @media (prefers-reduced-motion: reduce) {
      .elix-announcement__viewport { overflow-x: auto; }
      .elix-announcement__track { width: max-content; animation: none; transform: none; will-change: auto; }
      .elix-announcement__group[aria-hidden], .elix-announcement__message[aria-hidden] { display: none; }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Announcement marquee",
  "max_blocks": 1,
  "class": "announcement-bar-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement", "default": true },
    { "type": "checkbox", "id": "animate", "label": "Animate message", "default": true },
    { "type": "range", "id": "speed", "min": 18, "max": 45, "step": 1, "unit": "s", "label": "Scroll duration", "default": 28 }
  ],
  "blocks": [{
    "type": "announcement",
    "name": "Announcement",
    "settings": [
      { "type": "text", "id": "text", "label": "Message", "default": "🧬 ADVANCED BIOTECHNOLOGY & PRECISION PEPTIDE SCIENCE • 🔬 FOR LABORATORY RESEARCH USE ONLY • 🧪 NOT FOR HUMAN CONSUMPTION • ✨ EXPLORE THE ELIX LABS RESEARCH CATALOGUE" },
      { "type": "url", "id": "link", "label": "Optional link" }
    ]
  }],
  "presets": [{ "name": "Announcement marquee", "blocks": [{ "type": "announcement" }] }]
}
{% endschema %}
