{{ 'elix-rewards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'elix-rewards.js' | asset_url }}" defer="defer"></script>

<elix-rewards class="er" style="--blue:{{ section.settings.accent_blue }};--violet:{{ section.settings.accent_violet }};--gold:{{ section.settings.accent_gold }};--bg:{{ section.settings.background }}">
  <svg class="er__symbols" aria-hidden="true"><defs>
    <symbol id="er-dna" viewBox="0 0 150 230"><g vector-effect="non-scaling-stroke"><path d="M25 2C130 43 18 95 125 133S19 193 126 228M125 2C20 43 132 95 25 133s106 60-1 95"/><path class="dna-rungs" d="m43 16 64 20M25 48l100 18M25 81l100 15m-89 22 78 4m-89 31 100-12M29 185l93-15m-78 44 62-22"/><g class="dna-dots"><circle cx="25" cy="2" r="3"/><circle cx="125" cy="2" r="2"/><circle cx="25" cy="81" r="2.5"/><circle cx="125" cy="96" r="3"/><circle cx="25" cy="153" r="3"/><circle cx="122" cy="170" r="2"/><circle cx="24" cy="228" r="2"/><circle cx="126" cy="228" r="3"/></g></g></symbol>
    <symbol id="er-net" viewBox="0 0 250 160"><g vector-effect="non-scaling-stroke"><path d="M3 112 26 72 48 22 72 55 96 13 118 48 143 8 165 40 195 18 219 53 247 27M3 112l36 31 33-88 28 69 18-76 30 91 17-99 34 89 16-111 38 118 14-109M26 72l46-17 46-7 47-8 54 13M39 143l61-19 48 15 51-10 48 7M48 22l70 26 77-30M72 55l76 84 71-86M96 13l69 27 34 89M3 112l97 12 119-71M26 72l122 67 99-112"/><g><circle cx="3" cy="112" r="2"/><circle cx="26" cy="72" r="2.5"/><circle cx="39" cy="143" r="1.8"/><circle cx="48" cy="22" r="3"/><circle cx="72" cy="55" r="2"/><circle cx="96" cy="13" r="1.6"/><circle cx="100" cy="124" r="3"/><circle cx="118" cy="48" r="2"/><circle cx="143" cy="8" r="2.8"/><circle cx="148" cy="139" r="2"/><circle cx="165" cy="40" r="2"/><circle cx="195" cy="18" r="1.7"/><circle cx="199" cy="129" r="3"/><circle cx="219" cy="53" r="2.4"/><circle cx="233" cy="136" r="1.8"/><circle cx="247" cy="27" r="3"/><circle cx="61" cy="104" r="1.5"/><circle cx="128" cy="92" r="1.5"/><circle cx="183" cy="82" r="2.2"/><circle cx="230" cy="96" r="1.5"/></g></g></symbol>
    <symbol id="er-bag" viewBox="0 0 48 48"><g vector-effect="non-scaling-stroke"><path d="M10 15h28l-2.3 28H12.3L10 15Z"/><path d="M18 17v-6a6 6 0 0 1 12 0v6M14 19h20M15 22l1.4 17h15.2" opacity=".55"/></g></symbol>
    <symbol id="er-plane" viewBox="0 0 48 48"><g vector-effect="non-scaling-stroke"><path d="M3 21.5 44 4 31.5 44l-9-14.5L3 21.5Z"/><path d="M22.5 29.5 44 4 14.5 26.2M22.5 29.5l-1.8 11 7.2-6"/><path d="m8 21.2 28-12" opacity=".5"/></g></symbol>
    <symbol id="er-star" viewBox="0 0 48 48"><g vector-effect="non-scaling-stroke"><circle cx="24" cy="24" r="21"/><circle cx="24" cy="24" r="17" opacity=".45"/><path d="m24 12.5 3.7 7.4 8.2 1.2-5.9 5.8 1.4 8.1-7.4-3.9-7.4 3.9 1.4-8.1-5.9-5.8 8.2-1.2 3.7-7.4Z"/></g></symbol>
    <symbol id="er-crown" viewBox="0 0 120 120"><g vector-effect="non-scaling-stroke"><circle cx="60" cy="60" r="49"/><circle cx="60" cy="60" r="42"/><circle cx="60" cy="60" r="34" stroke-dasharray="2 5"/><path d="M30 79c-11-12-12-27-6-40M90 79c11-12 12-27 6-40M29 72c-7-3-10-8-11-13m13 7c-8-6-9-12-8-18m10 10c-7-8-6-14-3-20m61 34c7-3 10-8 11-13m-13 7c8-6 9-12 8-18M87 58c7-8 6-14 3-20"/><path d="m42 48 9 9 9-18 9 18 10-9-4 25H46l-4-25Zm7 31h23"/><path d="M60 3v6m0 102v6M3 60h6m102 0h6M20 20l5 5m70 70 5 5m0-80-5 5M25 95l-5 5"/><g class="seal-dots"><circle cx="60" cy="3" r="2"/><circle cx="60" cy="117" r="2"/><circle cx="3" cy="60" r="2"/><circle cx="117" cy="60" r="2"/><circle cx="20" cy="20" r="1.5"/><circle cx="100" cy="20" r="1.5"/><circle cx="20" cy="100" r="1.5"/><circle cx="100" cy="100" r="1.5"/></g></g></symbol>
    <symbol id="er-people" viewBox="0 0 48 48"><circle cx="24" cy="15" r="7"/><circle cx="10" cy="19" r="5"/><circle cx="38" cy="19" r="5"/><path d="M13 40v-5c0-7 4-11 11-11s11 4 11 11v5H13ZM3 37v-4c0-5 3-8 8-8M45 37v-4c0-5-3-8-8-8"/></symbol>
    <symbol id="er-person" viewBox="0 0 48 48"><circle cx="24" cy="15" r="9"/><path d="M8 43c0-11 6-17 16-17s16 6 16 17H8Z"/></symbol>
  </defs></svg>

  <header class="er__hero">
    <svg class="er__dna er__dna--hero" aria-hidden="true"><use href="#er-dna"/></svg><svg class="er__net er__net--hero" aria-hidden="true"><use href="#er-net"/></svg>
    <div class="er__wrap er__hero-content"><h1>GIVE 10% OFF. GET 10%.</h1><p>Your friend gets 10% off. You earn 10% back in ELIX Credit.</p><a class="er__button" href="#your-elix-rewards">GET MY REFERRAL CODE</a></div>
  </header>

  <main class="er__wrap er__main">
    <section class="er__panel er__how" aria-labelledby="how-title"><h2 id="how-title"><span>HOW IT WORKS</span></h2>
      <ol class="er__steps">
        <li><b>01</b><svg aria-hidden="true"><use href="#er-bag"/></svg><div><h3>ORDER</h3><p>Complete your first ELIX order.</p></div></li>
        <li><b>02</b><svg aria-hidden="true"><use href="#er-plane"/></svg><div><h3>SHARE</h3><p>Send your personal code to friends.</p></div></li>
        <li><b>03</b><svg aria-hidden="true"><use href="#er-star"/></svg><div><h3>EARN</h3><p>Receive 10% back in ELIX Credit.</p></div></li>
      </ol>
      <p class="er__explanation">After your first eligible ELIX order, a personal referral code is added to your account.<br>Share it with friends: they receive 10% off their first eligible order. Once their order is completed and validated, you receive 10% of the amount paid as ELIX Credit for a future purchase.<br>Cancelled, refunded or self-referred orders do not qualify.</p>
    </section>

    <section class="er__panel er__rewards" id="your-elix-rewards" aria-labelledby="rewards-title"><h2 id="rewards-title">YOUR ELIX REWARDS</h2><p class="er__kicker">SARA B. — MEMBER DASHBOARD EXAMPLE</p>
      <div class="er__dashboard"><button class="er__code" type="button" data-elix-copy="SARA10" data-success-message="CODE COPIED" data-error-message="COPY SARA10"><span>YOUR REFERRAL CODE</span><strong>SARA10</strong><small data-elix-copy-status>Share this code with your friends</small></button>
        <dl class="er__stats"><div><dt>AVAILABLE CREDIT</dt><dd>47,50 €</dd></div><div><dt>PENDING</dt><dd>2</dd></div><div><dt>VALIDATED<br>REFERRALS</dt><dd>4</dd></div><div><dt>FRIENDS<br>INVITED</dt><dd>6</dd></div></dl>
        <div class="er__actions"><a class="er__button" href="{{ routes.account_login_url }}">SIGN IN</a><a class="er__button er__button--outline" href="{{ routes.account_register_url }}">CREATE ACCOUNT</a></div>
      </div><p class="er__demo">Example data — sign in to view your real rewards.</p>
    </section>

    {% if section.settings.show_leaderboard %}<div class="er__ranking-row">
      <section class="er__panel er__leaderboard" aria-labelledby="leaderboard-title"><h2 id="leaderboard-title">ELIX GLOBAL LEADERBOARD</h2><p class="er__kicker">PREVIEW LEADERBOARD — EXAMPLE DATA</p><div class="er__table"><table><thead><tr><th>RANK</th><th>AMBASSADOR</th><th>COUNTRY</th><th>VALIDATED REFERRALS</th><th>ELIX CREDIT</th></tr></thead><tbody>
        <tr><td>1</td><td>Alex M.</td><td><span aria-label="Germany">🇩🇪</span></td><td>86</td><td>1 247 €</td></tr><tr><td>2</td><td>Sofia R.</td><td><span aria-label="France">🇫🇷</span></td><td>68</td><td>952 €</td></tr><tr><td>3</td><td>Daniel K.</td><td><span aria-label="Sweden">🇸🇪</span></td><td>52</td><td>754 €</td></tr><tr><td>4</td><td>Marco L.</td><td><span aria-label="Italy">🇮🇹</span></td><td>39</td><td>546 €</td></tr><tr><td>5</td><td>Samir B.</td><td><span aria-label="Belgium">🇧🇪</span></td><td>31</td><td>434 €</td></tr>
      </tbody></table></div></section>
      <aside class="er__panel er__bonus"><h2>TOP 3 MONTHLY BONUS</h2><div><p><b>1<sup>ST</sup></b><strong>€{{ section.settings.first_bonus }}</strong></p><p><b>2<sup>ND</sup></b><strong>€{{ section.settings.second_bonus }}</strong></p><p><b>3<sup>RD</sup></b><strong>€{{ section.settings.third_bonus }}</strong></p></div><small>Extra ELIX Credit awarded each month.</small></aside>
    </div>{% endif %}

    <section class="er__panel er__ambassador" aria-labelledby="ambassador-title"><svg class="er__crown" aria-hidden="true"><use href="#er-crown"/></svg><svg class="er__net er__net--gold" aria-hidden="true"><use href="#er-net"/></svg><div class="er__ambassador-copy"><h2 id="ambassador-title">ELIX AMBASSADOR</h2><h3>Have a community on social media?</h3><p>Approved ambassadors earn cash commissions paid by bank transfer — not ELIX Credit.</p></div>
      <div class="er__paths"><div><svg aria-hidden="true"><use href="#er-people"/></svg><b>{{ section.settings.threshold }} VALIDATED ORDERS<br>IN ONE MONTH</b></div><span>OR</span><div><svg aria-hidden="true"><use href="#er-person"/></svg><b>APPLY DIRECTLY</b></div></div>
      <form class="er__form" data-elix-ambassador-form data-recipient="{{ section.settings.ambassador_email | escape }}" data-subject="ELIX Ambassador Programme" data-email-body="Email: [EMAIL]&#10;&#10;Include links to your social profiles."><label class="visually-hidden" for="AmbassadorEmail-{{ section.id }}">Your email address</label><input id="AmbassadorEmail-{{ section.id }}" name="email" type="email" autocomplete="email" placeholder="Your email address" required><button type="submit">SEND MY APPLICATION</button></form>
      <p class="er__contact">Or contact us at <a href="mailto:{{ section.settings.ambassador_email | escape }}?subject=ELIX%20Ambassador%20Programme">{{ section.settings.ambassador_email | escape }}</a><br>Subject: ELIX Ambassador Programme<br>Include links to your social profiles. We’re open to discussion.</p><p class="er__terms">ⓘ &nbsp; Applications are reviewed, and commission/payout terms are agreed after approval.</p>
    </section>

    <section class="er__faqs" aria-label="Frequently asked questions"><div class="er__panel"><h2>ELIX REWARDS FAQ</h2>
      <details><summary>How do I get my referral code?</summary><p>After your first eligible ELIX order is completed, your personal code is added to your account.</p></details><details><summary>When do I receive my ELIX Credit?</summary><p>Credit is added after the referred order is paid, completed, validated and has passed cancellation and refund checks.</p></details><details><summary>Can I refer myself?</summary><p>No. Self-referrals, duplicate accounts and fraudulent activity do not qualify.</p></details><details><summary>Is there a limit?</summary><p>There is no stated referral reward limit, but every order must remain eligible and validated.</p></details><details><summary>Where can I track my rewards?</summary><p>Sign in to your ELIX account to see available credit, pending rewards and validated referrals.</p></details>
    </div><div class="er__panel"><h2>ELIX AMBASSADOR FAQ</h2>
      <details><summary>Who can become an Ambassador?</summary><p>Creators, educators and community leaders with an authentic, relevant audience may be considered.</p></details><details><summary>How do I apply?</summary><p>Use the email form above or email our team with the subject “ELIX Ambassador Programme”.</p></details><details><summary>When can I receive bank transfers?</summary><p>Only approved Ambassadors can receive bank-transfer commissions under their individually agreed validation and payment schedule.</p></details><details><summary>What should I include in my application?</summary><p>Include your name, country, social profile links, community size and type, and a brief collaboration proposal.</p></details><details><summary>How are commission terms decided?</summary><p>Rates, eligibility, validation periods and payout terms are discussed individually and agreed after approval.</p></details>
    </div></section>

    <section class="er__final"><svg class="er__dna" aria-hidden="true"><use href="#er-dna"/></svg><svg class="er__net" aria-hidden="true"><use href="#er-net"/></svg><h2>READY TO SHARE ELIX?</h2><a class="er__button" href="#your-elix-rewards">GET MY REFERRAL CODE</a></section>
  </main>
</elix-rewards>

{% schema %}
{"name":"ELIX Rewards","tag":"section","class":"section","settings":[
  {"type":"color","id":"background","label":"Background","default":"#020810"},{"type":"color","id":"accent_blue","label":"Blue accent","default":"#147dff"},{"type":"color","id":"accent_violet","label":"Violet accent","default":"#a827ff"},{"type":"color","id":"accent_gold","label":"Ambassador gold","default":"#d98b18"},
  {"type":"checkbox","id":"show_leaderboard","label":"Show demo leaderboard","default":true},{"type":"range","id":"first_bonus","label":"First-place bonus (€)","min":0,"max":100,"step":5,"default":50},{"type":"range","id":"second_bonus","label":"Second-place bonus (€)","min":0,"max":100,"step":5,"default":30},{"type":"range","id":"third_bonus","label":"Third-place bonus (€)","min":0,"max":100,"step":5,"default":15},{"type":"range","id":"threshold","label":"Automatic review threshold","min":10,"max":100,"step":5,"default":50},{"type":"text","id":"ambassador_email","label":"Ambassador email","default":"contact.elixlab@gmail.com"}
],"presets":[{"name":"ELIX Rewards"}]}
{% endschema %}
