<section class="elix-faq elix-faq--{{ section.id }} page-width">
  <div class="elix-faq__header">
    <p class="elix-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="elix-faq__items">
    {% for block in section.blocks %}
      <details class="elix-faq__item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question | escape }}</summary>
        <div class="rte">{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</section>
<style>
  .elix-faq--{{ section.id }} { padding-top: 7rem; padding-bottom: 7rem; }
  .elix-faq--{{ section.id }} .elix-faq__header { max-width: 72rem; margin-bottom: 3rem; }
  .elix-faq--{{ section.id }} h2 { font-size: clamp(3rem, 5vw, 5.6rem); margin: 0; }
  .elix-faq--{{ section.id }} .elix-faq__eyebrow { color: #4b7560; font-weight: 700; letter-spacing: .18em; margin: 0 0 1.6rem; text-transform: uppercase; }
  .elix-faq--{{ section.id }} .elix-faq__items { border-top: .1rem solid rgba(var(--color-foreground), .14); }
  .elix-faq--{{ section.id }} .elix-faq__item { border-bottom: .1rem solid rgba(var(--color-foreground), .14); padding: 1.8rem 0; }
  .elix-faq--{{ section.id }} summary { cursor: pointer; font-weight: 700; font-size: 1.9rem; }
</style>
{% schema %}
{
  "name": "ELIX FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Answers before you order." }
  ],
  "blocks": [{ "type": "faq", "name": "FAQ", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "Are ELIX LABS products for research use only?" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Yes. Products are intended for qualified laboratory research and are not for human consumption.</p>" }
  ]}],
  "presets": [{ "name": "ELIX FAQ" }]
}
{% endschema %}
