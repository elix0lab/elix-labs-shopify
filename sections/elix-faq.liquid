{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<section class="elix-lux elix-section"><div class="elix-wrap"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-faq-list">{% for block in section.blocks %}<details class="elix-card elix-faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question }} <span>+</span></summary><div class="elix-copy">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section><style>.elix-faq-list{display:grid;gap:1.4rem;margin-top:4rem}.elix-faq-item{padding:0}.elix-faq-item summary{cursor:pointer;list-style:none;padding:2.2rem 2.6rem;color:#fff;font-size:2rem;font-weight:900;display:flex;justify-content:space-between}.elix-faq-item .elix-copy{padding:0 2.6rem 2.4rem}.elix-faq-item[open] summary span{transform:rotate(45deg)}</style>{% schema %}{"name":"ELIX FAQ","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FAQ"},{"type":"text","id":"heading","label":"Heading","default":"Answers before you order."}],"blocks":[{"type":"faq","name":"FAQ","settings":[{"type":"text","id":"question","label":"Question","default":"Are products for research use only?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Yes. ELIX LABS products are intended for qualified laboratory research and are not for human consumption.</p>"}]}],"presets":[{"name":"ELIX FAQ"}]}{% endschema %}
