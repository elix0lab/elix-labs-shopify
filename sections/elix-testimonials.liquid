{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<section class="elix-lux elix-section"><div class="elix-wrap"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-products">{% for block in section.blocks %}<article class="elix-card elix-quote" {{ block.shopify_attributes }}><div class="stars">★★★★★</div><p>“{{ block.settings.quote }}”</p><b>{{ block.settings.name }}</b><span>✓ {{ block.settings.badge }}</span></article>{% endfor %}</div></div></section><style>.elix-quote{padding:3rem;min-width:32rem}.elix-quote .stars{color:#7DE2FC;letter-spacing:.18em}.elix-quote p{font-size:1.9rem;line-height:1.65;color:rgba(255,255,255,.78)}.elix-quote b{display:block;color:#fff}.elix-quote span{color:#8B5CF6;font-weight:800}</style>{% schema %}{"name":"ELIX testimonials","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Testimonials"},{"type":"text","id":"heading","label":"Heading","default":"Trusted by modern researchers."}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"textarea","id":"quote","label":"Quote","default":"Premium presentation, clear communication and excellent dispatch speed."},{"type":"text","id":"name","label":"Name","default":"Verified customer"},{"type":"text","id":"badge","label":"Badge","default":"Verified buyer"}]}],"presets":[{"name":"ELIX testimonials"}]}{% endschema %}
