{{ 'elix-about-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hero_overlay = section.settings.hero_overlay | divided_by: 100.0
  assign research_url = section.settings.research_link | default: '/pages/research-hub'
  assign products_url = section.settings.products_link | default: routes.all_products_collection_url
  assign hero_alt = section.settings.hero_image.alt | default: 'Laboratoire de biotechnologie ELIX LABS'
-%}

<section class="elix-about" style="--elix-about-hero-overlay: {{ hero_overlay }}; --elix-about-section-space: {{ section.settings.section_spacing }}px;" data-elix-about{% if section.settings.enable_animations %} data-elix-about-animate{% endif %}>
  <div class="elix-about-hero">
    <img class="elix-about-hero__image" src="https://cdn.shopify.com/s/files/1/0944/3082/2736/files/ChatGPT_Image_5_aout_2026_23_36_01.png?v=1785965784" alt="{{ hero_alt | escape }}" loading="eager" fetchpriority="high">
    <div class="elix-about-hero__shade" aria-hidden="true"></div>
    <div class="elix-about-hero__inner elix-about-container">
      <div class="elix-about-hero__copy elix-about-reveal">
        <p class="elix-about-eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="elix-about-hero__title">
          <span>{{ section.settings.hero_title_primary | newline_to_br }}</span>
          <span class="elix-about-gradient">{{ section.settings.hero_title_gradient | newline_to_br }}</span>
        </h1>
        <blockquote class="elix-about-hero__quote">{{ section.settings.hero_quote | newline_to_br }}</blockquote>
      </div>
    </div>
  </div>

  <div class="elix-about-body">
    <section class="elix-about-text-section elix-about-container elix-about-reveal">
      <p class="elix-about-eyebrow">{{ section.settings.story_eyebrow }}</p>
      <h2>{{ section.settings.story_title }}</h2>
      <div class="elix-about-rte">{{ section.settings.story_text | newline_to_br }}</div>
    </section>

    <section class="elix-about-letter elix-about-container elix-about-panel elix-about-reveal">
      <span class="elix-about-letter__mark" aria-hidden="true">“</span>
      <h2 class="elix-about-panel-title">{{ section.settings.letter_title }}</h2>
      <div class="elix-about-letter__text">{{ section.settings.letter_text | newline_to_br }}</div>
      <div class="elix-about-letter__signature" aria-hidden="true">— Le Fondateur</div>
    </section>

    <section class="elix-about-team elix-about-container elix-about-panel elix-about-reveal">
      <p class="elix-about-eyebrow">{{ section.settings.team_eyebrow }}</p>
      <h2>{{ section.settings.team_title }}</h2>
      <div class="elix-about-team__intro">{{ section.settings.team_intro | newline_to_br }}</div>
      <div class="elix-about-team__founder">
        <article class="elix-about-member elix-about-member--featured">
          <div class="elix-about-member__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="8"/><path d="M10 42c2.5-9 8-14 14-14s11.5 5 14 14"/></svg></div>
          <h3>{{ section.settings.founder_name }}</h3>
          <p class="elix-about-member__status">{{ section.settings.founder_status }}</p>
          <p class="elix-about-member__role">{{ section.settings.founder_role }}</p>
          <p>{{ section.settings.founder_text }}</p>
        </article>
      </div>
      <div class="elix-about-team__grid">
        <article class="elix-about-member">
          <div class="elix-about-member__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="8"/><path d="M10 42c2.5-9 8-14 14-14s11.5 5 14 14"/></svg></div>
          <h3>{{ section.settings.member_1_name }}</h3>
          <p class="elix-about-member__status">{{ section.settings.member_1_status }}</p>
          <p class="elix-about-member__role">{{ section.settings.member_1_role }}</p>
          <p>{{ section.settings.member_1_text }}</p>
        </article>
        <article class="elix-about-member">
          <div class="elix-about-member__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="8"/><path d="M10 42c2.5-9 8-14 14-14s11.5 5 14 14"/></svg></div>
          <h3>{{ section.settings.member_2_name }}</h3>
          <p class="elix-about-member__status">{{ section.settings.member_2_status }}</p>
          <p class="elix-about-member__role">{{ section.settings.member_2_role }}</p>
          <p>{{ section.settings.member_2_text }}</p>
        </article>
        <article class="elix-about-member">
          <div class="elix-about-member__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="8"/><path d="M10 42c2.5-9 8-14 14-14s11.5 5 14 14"/></svg></div>
          <h3>{{ section.settings.member_3_name }}</h3>
          <p class="elix-about-member__status">{{ section.settings.member_3_status }}</p>
          <p class="elix-about-member__role">{{ section.settings.member_3_role }}</p>
          <p>{{ section.settings.member_3_text }}</p>
        </article>
        <article class="elix-about-member">
          <div class="elix-about-member__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="24" cy="17" r="8"/><path d="M10 42c2.5-9 8-14 14-14s11.5 5 14 14"/></svg></div>
          <h3>{{ section.settings.member_4_name }}</h3>
          <p class="elix-about-member__status">{{ section.settings.member_4_status }}</p>
          <p class="elix-about-member__role">{{ section.settings.member_4_role }}</p>
          <p>{{ section.settings.member_4_text }}</p>
        </article>
      </div>
      <div class="elix-about-team__closing">{{ section.settings.team_closing | newline_to_br }}</div>
    </section>

    <section class="elix-about-bigquote elix-about-container elix-about-reveal" aria-label="ELIX LABS philosophy">
      <span aria-hidden="true">“</span>
      <p>La connaissance <strong>crée la confiance.</strong><br>La transparence <strong>crée la confiance.</strong></p>
      <span aria-hidden="true">”</span>
    </section>

    <section class="elix-about-text-section elix-about-container elix-about-reveal"><h2>{{ section.settings.era_title }}</h2><div class="elix-about-rte">{{ section.settings.era_text | newline_to_br }}</div></section>
    <section class="elix-about-text-section elix-about-container elix-about-reveal"><h2>{{ section.settings.exist_title }}</h2><div class="elix-about-rte">{{ section.settings.exist_text | newline_to_br }}</div></section>

    <section class="elix-about-duo elix-about-container elix-about-reveal">
      <article><h2>{{ section.settings.mission_title }}</h2><div>{{ section.settings.mission_text | newline_to_br }}</div></article>
      <article><h2>{{ section.settings.vision_title }}</h2><div>{{ section.settings.vision_text | newline_to_br }}</div></article>
    </section>

    <section class="elix-about-commitment elix-about-container elix-about-reveal">
      <h2>{{ section.settings.commitment_title }}</h2>
      <div class="elix-about-commitment__grid">
        <article class="elix-about-commitment-card">
          <div class="elix-about-commitment-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 5 40 12v11c0 10-6.5 16.5-16 20C14.5 39.5 8 33 8 23V12Z"/><path d="m17 24 5 5 10-12"/></svg></div>
          <h3>{{ section.settings.commitment_1_title }}</h3><p>{{ section.settings.commitment_1_text | newline_to_br }}</p>
        </article>
        <article class="elix-about-commitment-card">
          <div class="elix-about-commitment-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M7 11c7-1 12 1 17 6 5-5 10-7 17-6v28c-7-1-12 1-17 6-5-5-10-7-17-6Z"/><path d="M24 17v28"/></svg></div>
          <h3>{{ section.settings.commitment_2_title }}</h3><p>{{ section.settings.commitment_2_text | newline_to_br }}</p>
        </article>
        <article class="elix-about-commitment-card">
          <div class="elix-about-commitment-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M4 24s7-12 20-12 20 12 20 12-7 12-20 12S4 24 4 24Z"/><circle cx="24" cy="24" r="6"/></svg></div>
          <h3>{{ section.settings.commitment_3_title }}</h3><p>{{ section.settings.commitment_3_text | newline_to_br }}</p>
        </article>
        <article class="elix-about-commitment-card">
          <div class="elix-about-commitment-card__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M38 17a15 15 0 1 0 1 14"/><path d="M38 8v9h-9"/><path d="M24 14v10l7 4"/></svg></div>
          <h3>{{ section.settings.commitment_4_title }}</h3><p>{{ section.settings.commitment_4_text | newline_to_br }}</p>
        </article>
      </div>
    </section>

    <section class="elix-about-text-section elix-about-container elix-about-reveal"><h2>{{ section.settings.beyond_title }}</h2><div class="elix-about-rte">{{ section.settings.beyond_text | newline_to_br }}</div></section>

    <section class="elix-about-final elix-about-container elix-about-panel elix-about-reveal">
      <h2>{{ section.settings.join_title }}</h2>
      <blockquote>{{ section.settings.join_quote | newline_to_br }}</blockquote>
      <div>{{ section.settings.join_text | newline_to_br }}</div>
      <div class="elix-about-final__buttons">
        <a class="elix-about-button elix-about-button--primary" href="{{ research_url }}">{{ section.settings.research_label }} <span aria-hidden="true">→</span></a>
        <a class="elix-about-button elix-about-button--secondary" href="{{ products_url }}">{{ section.settings.products_label }} <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "ELIX About Page",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "range", "id": "hero_overlay", "label": "Hero overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "range", "id": "section_spacing", "label": "Main vertical spacing", "min": 56, "max": 150, "step": 2, "unit": "px", "default": 96 },
    { "type": "checkbox", "id": "enable_animations", "label": "Enable subtle scroll animations", "default": true },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "À PROPOS D’ELIX LABS" },
    { "type": "textarea", "id": "hero_title_primary", "label": "Hero title first part", "default": "PLUS QU’UN LABORATOIRE." },
    { "type": "textarea", "id": "hero_title_gradient", "label": "Hero title gradient part", "default": "UNE VISION POUR L’AVENIR\nDES BIOTECHNOLOGIES." },
    { "type": "textarea", "id": "hero_quote", "label": "Hero quote", "default": "« La science ne change le monde que lorsque la connaissance devient accessible. »" },
    { "type": "text", "id": "story_eyebrow", "label": "Story eyebrow", "default": "NOTRE HISTOIRE" },
    { "type": "text", "id": "story_title", "label": "Story title", "default": "Une conviction devenue une mission." },
    { "type": "textarea", "id": "story_text", "label": "Story text", "default": "Pendant des décennies, la recherche sur les peptides est restée essentiellement confinée aux laboratoires, aux universités et aux centres de recherche spécialisés.\n\nPour la plupart des personnes, ces molécules demeuraient méconnues. Les informations étaient dispersées. Les publications scientifiques étaient difficiles à comprendre. Les données étaient souvent réservées à ceux qui possédaient les connaissances nécessaires pour les interpréter.\n\nComprendre le fonctionnement d’un peptide pouvait demander des dizaines d’heures de lecture scientifique. Pourtant, derrière cette complexité se cache un domaine de recherche fascinant. Un domaine qui évolue rapidement. Un domaine qui participe à une période exceptionnelle pour les biotechnologies.\n\nC’est de cette conviction qu’est né ELIX LABS.\n\nNous croyons que la science ne devrait jamais être inaccessible. Nous croyons qu’une information fiable, expliquée avec rigueur et pédagogie, permet à chacun de mieux comprendre les découvertes scientifiques.\n\nFondé par un médecin passionné par les biotechnologies et la recherche médicale, ELIX LABS a été imaginé comme un pont entre la recherche moderne et toutes les personnes désireuses d’en apprendre davantage.\n\nNotre objectif n’a jamais été de simplifier la science. Notre objectif est de la rendre compréhensible.\n\nParce que lorsque la connaissance devient accessible, elle inspire de nouvelles idées.\n\nEt les nouvelles idées sont à l’origine des plus grandes avancées de l’humanité." },
    { "type": "text", "id": "letter_title", "label": "Letter title", "default": "LETTRE DU FONDATEUR" },
    { "type": "textarea", "id": "letter_text", "label": "Letter text", "default": "Cher lecteur,\n\nSi vous lisez ces mots, merci.\n\nELIX LABS n’est pas né d’un business plan, mais d’une observation simple. Au cours de mon parcours médical, j’ai compris que certaines des découvertes scientifiques les plus fascinantes restent encore inaccessibles à la majorité des personnes. Non pas par manque de curiosité, mais parce que l’information est souvent dispersée dans des publications complexes, rédigées pour des spécialistes et rarement expliquées d’une manière que chacun peut réellement comprendre.\n\nJ’ai toujours pensé que la connaissance ne devait jamais être un privilège. Elle doit être partagée, expliquée, questionnée et constamment enrichie. C’est cette conviction qui a donné naissance à ELIX LABS.\n\nDès le début, ma vision n’a jamais été de créer une entreprise de plus. Je voulais construire un espace où la science passe avant le marketing, où la transparence passe avant les promesses et où l’éducation est considérée comme aussi importante que l’innovation.\n\nVous remarquerez que mon nom n’apparaît nulle part sur ce site. Ce choix est volontaire. En tant que médecin, j’ai choisi de rester anonyme afin de préserver l’indépendance de ma carrière médicale et de maintenir une séparation éthique claire entre ma pratique clinique et ELIX LABS.\n\nJe n’ai jamais voulu que ce projet repose sur une seule personne. Je veux qu’il soit défini par ses valeurs, son intégrité, la qualité de ses ressources éducatives et la confiance qu’il construit avec le temps.\n\nSi ELIX LABS réussit un jour, j’espère que ce ne sera pas parce que les gens se souviendront du nom de son fondateur. J’espère qu’ils se souviendront de la manière dont ELIX LABS a rendu la science plus facile à comprendre, encouragé la curiosité, donné envie de continuer à apprendre et toujours choisi la transparence plutôt que les raccourcis.\n\nQue vous soyez ici pour explorer, apprendre ou simplement parce que l’avenir des biotechnologies vous intrigue, merci de faire partie de cette aventure.\n\nCe n’est que le début." },
    { "type": "text", "id": "team_eyebrow", "label": "Team eyebrow", "default": "NOTRE ÉQUIPE" },
    { "type": "text", "id": "team_title", "label": "Team title", "default": "Construite autour d’une vision. Portée par des personnes." },
    { "type": "textarea", "id": "team_intro", "label": "Team intro", "default": "ELIX LABS a été fondée en Allemagne en 2025 par un médecin passionné par les biotechnologies, la recherche sur les peptides et l’éducation scientifique.\n\nAfin de préserver l’indépendance de sa carrière médicale et de maintenir une séparation claire entre sa pratique clinique et ELIX LABS, le fondateur a choisi de rester anonyme pour des raisons professionnelles et éthiques.\n\nChez ELIX LABS, nous pensons que l’attention doit toujours rester portée sur la qualité de nos ressources éducatives, nos standards scientifiques et notre engagement en faveur de la transparence, plutôt que sur la personne à l’origine du projet.\n\nÀ mesure qu’ELIX LABS se développe, notre ambition est de construire une équipe multidisciplinaire dédiée à l’éducation scientifique, à l’expérience client et à l’excellence opérationnelle." },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Fondateur" }, { "type": "text", "id": "founder_status", "label": "Founder status", "default": "Médecin anonyme" }, { "type": "text", "id": "founder_role", "label": "Founder role", "default": "Fondateur et directeur scientifique" }, { "type": "textarea", "id": "founder_text", "label": "Founder text", "default": "Médecin et fondateur d’ELIX LABS, responsable de la vision à long terme de l’entreprise, de sa direction scientifique, de sa stratégie éducative et de ses standards de qualité." },
    { "type": "text", "id": "member_1_name", "label": "Member 1 name", "default": "Noémie" }, { "type": "text", "id": "member_1_status", "label": "Member 1 status", "default": "Prévu" }, { "type": "text", "id": "member_1_role", "label": "Member 1 role", "default": "Responsable de l’expérience client" }, { "type": "textarea", "id": "member_1_text", "label": "Member 1 text", "default": "Responsable de l’assistance client, des échanges sur WhatsApp, des e-mails et de la qualité de l’accompagnement, afin que chaque client bénéficie d’une expérience rapide, professionnelle et personnalisée." },
    { "type": "text", "id": "member_2_name", "label": "Member 2 name", "default": "Sarra" }, { "type": "text", "id": "member_2_status", "label": "Member 2 status", "default": "Prévu" }, { "type": "text", "id": "member_2_role", "label": "Member 2 role", "default": "Responsable de la marque et de la communauté" }, { "type": "textarea", "id": "member_2_text", "label": "Member 2 text", "default": "Responsable des réseaux sociaux, de la communication visuelle, de l’animation de la communauté, des partenariats et de la représentation de l’image ELIX LABS sur les plateformes numériques." },
    { "type": "text", "id": "member_3_name", "label": "Member 3 name", "default": "Julie" }, { "type": "text", "id": "member_3_status", "label": "Member 3 status", "default": "Prévu" }, { "type": "text", "id": "member_3_role", "label": "Member 3 role", "default": "Responsable des opérations" }, { "type": "textarea", "id": "member_3_text", "label": "Member 3 text", "default": "Supervise les opérations quotidiennes, la coordination des fournisseurs, le contrôle qualité, l’organisation interne et veille à ce que chaque commande respecte les standards ELIX LABS." },
    { "type": "text", "id": "member_4_name", "label": "Member 4 name", "default": "Lukas" }, { "type": "text", "id": "member_4_status", "label": "Member 4 status", "default": "Prévu" }, { "type": "text", "id": "member_4_role", "label": "Member 4 role", "default": "Responsable logistique" }, { "type": "textarea", "id": "member_4_text", "label": "Member 4 text", "default": "Responsable de la gestion des stocks, des expéditions, de la préparation des commandes et de l’organisation logistique afin de garantir des livraisons fiables et efficaces." },
    { "type": "textarea", "id": "team_closing", "label": "Team closing", "default": "Ensemble, nous partageons une même mission.\n\nRendre la connaissance scientifique plus accessible, plus compréhensible et plus transparente pour toutes les personnes intéressées par l’avenir des biotechnologies." },
    { "type": "text", "id": "era_title", "label": "Era title", "default": "UNE NOUVELLE ÈRE SCIENTIFIQUE" },
    { "type": "textarea", "id": "era_text", "label": "Era text", "default": "Nous vivons une période unique. Rarement dans l’histoire de la médecine, autant de disciplines n’ont progressé simultanément.\n\nL’intelligence artificielle transforme la recherche. Le séquençage génétique devient plus rapide et plus accessible. La médecine personnalisée progresse. Les biotechnologies ouvrent des perspectives inédites.\n\nLes peptides, la médecine régénérative, les thérapies ciblées et d’autres domaines de recherche continuent d’être explorés par des équipes scientifiques dans le monde entier.\n\nNous sommes peut-être au début d’une nouvelle étape de l’innovation biomédicale. Une époque où la médecine cherche à comprendre les mécanismes du vivant avec une précision toujours plus grande. Une époque où les découvertes s’accélèrent.\n\nComprendre avant de croire. Comprendre avant de partager. Comprendre avant d’interpréter.\n\nChez ELIX LABS, nous pensons que l’accès à une information claire, rigoureuse et accessible sera l’un des plus grands défis de cette nouvelle ère scientifique.\n\nParce que la véritable révolution ne réside pas uniquement dans les découvertes. Elle réside dans notre capacité collective à les comprendre." },
    { "type": "text", "id": "exist_title", "label": "Why title", "default": "POURQUOI NOUS EXISTONS" },
    { "type": "textarea", "id": "exist_text", "label": "Why text", "default": "Chaque année, des milliers d’études scientifiques sont publiées. Des centaines de nouvelles molécules sont étudiées. Les connaissances évoluent à une vitesse sans précédent.\n\nPourtant, une question demeure.\n\nPourquoi est-il toujours aussi difficile de trouver une information fiable, compréhensible et transparente ?\n\nChez ELIX LABS, nous voulons réduire cette distance. Nous voulons transformer des données complexes en connaissances accessibles.\n\nNous voulons créer un espace où chacun peut apprendre, explorer et développer son esprit critique.\n\nParce que comprendre la science est le premier pas vers une meilleure compréhension du monde." },
    { "type": "text", "id": "mission_title", "label": "Mission title", "default": "NOTRE MISSION" },
    { "type": "textarea", "id": "mission_text", "label": "Mission text", "default": "Notre mission est simple.\n\nConstruire la plateforme éducative consacrée aux peptides la plus complète, la plus transparente et la plus accessible.\n\nNous voulons que chaque personne puisse comprendre ce qu’est un peptide, comment il agit, pourquoi il est étudié, quelles recherches existent, quelles sont les connaissances actuelles, quelles sont leurs limites et quelles questions restent encore ouvertes.\n\nNous croyons que la connaissance doit être structurée, accessible, claire et toujours fondée sur les données disponibles.\n\nParce que chaque grande innovation commence par une meilleure compréhension." },
    { "type": "text", "id": "vision_title", "label": "Vision title", "default": "NOTRE VISION" },
    { "type": "textarea", "id": "vision_text", "label": "Vision text", "default": "Nous croyons que les prochaines décennies seront marquées par une accélération majeure des biotechnologies.\n\nLes peptides ne représentent qu’une partie de cette évolution. L’intelligence artificielle, la médecine personnalisée, la biologie computationnelle, la médecine régénérative et les thérapies ciblées participent toutes à transformer progressivement notre compréhension du vivant.\n\nNotre ambition est d’accompagner cette évolution en construisant l’une des plateformes éducatives les plus complètes dans le domaine des peptides.\n\nFaire d’ELIX LABS une référence pour celles et ceux qui souhaitent apprendre, comprendre et suivre les avancées scientifiques.\n\nNon pas parce que nous prétendons détenir toutes les réponses, mais parce que nous croyons profondément que les bonnes questions font progresser la science." },
    { "type": "text", "id": "commitment_title", "label": "Commitment title", "default": "NOS ENGAGEMENTS" },
    { "type": "text", "id": "commitment_1_title", "label": "Commitment 1 title", "default": "Intégrité scientifique" }, { "type": "textarea", "id": "commitment_1_text", "label": "Commitment 1 text", "default": "Chaque information publiée est élaborée à partir de la littérature scientifique disponible.\n\nNotre priorité est la rigueur, la précision et la transparence." },
    { "type": "text", "id": "commitment_2_title", "label": "Commitment 2 title", "default": "L’éducation avant tout" }, { "type": "textarea", "id": "commitment_2_text", "label": "Commitment 2 text", "default": "Nous croyons qu’une communauté mieux informée est une communauté plus responsable.\n\nNotre objectif est d’expliquer des concepts complexes avec des mots simples, sans perdre leur profondeur scientifique." },
    { "type": "text", "id": "commitment_3_title", "label": "Commitment 3 title", "default": "Transparence" }, { "type": "textarea", "id": "commitment_3_text", "label": "Commitment 3 text", "default": "La confiance ne se construit pas avec des slogans.\n\nElle se construit avec des faits.\n\nNous préférons expliquer plutôt que promettre. Informer plutôt qu’impressionner." },
