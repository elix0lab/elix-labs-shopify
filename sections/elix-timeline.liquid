{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<section class="elix-lux elix-section"><div class="elix-wrap"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-timeline">{% for block in section.blocks %}<div class="elix-step" {{ block.shopify_attributes }}><span>{{ forloop.index }}</span><div class="elix-card"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div></div>{% endfor %}</div></div></section><style>.elix-timeline{position:relative;margin-top:5rem}.elix-timeline:before{content:"";position:absolute;left:2rem;top:0;bottom:0;width:2px;background:linear-gradient(#4B75FF,#8B5CF6,#7DE2FC)}.elix-step{display:grid;grid-template-columns:5rem 1fr;gap:2rem;margin:0 0 2rem}.elix-step>span{width:4rem;height:4rem;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#4B75FF,#8B5CF6);color:#fff;font-weight:900;z-index:1}.elix-step .elix-card{padding:2.4rem}.elix-step h3{color:#fff;margin:0}.elix-step p{color:rgba(255,255,255,.65)}</style>{% schema %}{"name":"ELIX interactive timeline","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Workflow"},{"type":"text","id":"heading","label":"Heading","default":"From research to worldwide delivery."}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"title","label":"Title","default":"Research"},{"type":"textarea","id":"text","label":"Text","default":"Protocols and market needs guide every catalog decision."}]}],"presets":[{"name":"ELIX interactive timeline"}]}{% endschema %}
