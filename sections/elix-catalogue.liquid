{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-elix-catalogue.css' | asset_url | stylesheet_tag }}

<main class="elix-catalogue" id="ElixCatalogue-{{ section.id }}">
  <header class="elix-catalogue__hero">
    <div class="elix-catalogue__wrap">
      {%- if section.settings.eyebrow != blank -%}<p class="elix-catalogue__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1>{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.intro != blank -%}<p class="elix-catalogue__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
      {%- if section.settings.show_notice -%}
        <p class="elix-catalogue__notice">For laboratory research use only. Not for human consumption.</p>
      {%- endif -%}
    </div>
  </header>

  <div class="elix-catalogue__collections elix-catalogue__wrap">
    {%- for block in section.blocks -%}
      {%- assign catalogue_collection = block.settings.collection -%}
      {%- if catalogue_collection != blank and catalogue_collection.products_count > 0 -%}
        {%- assign collection_heading = block.settings.heading | default: catalogue_collection.title -%}
        {%- assign collection_description = block.settings.description -%}
        {%- if collection_description == blank -%}
          {%- assign collection_description = catalogue_collection.description | strip_html | truncatewords: 28 -%}
        {%- endif -%}
        <section class="elix-catalogue__collection elix-catalogue__collection--{{ block.settings.palette }}" aria-labelledby="CatalogueHeading-{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="elix-catalogue__collection-head">
            <div>
              <p class="elix-catalogue__field">Research field</p>
              <h2 id="CatalogueHeading-{{ block.id }}">{{ collection_heading | escape }}</h2>
              {%- if collection_description != blank -%}<p>{{ collection_description | escape }}</p>{%- endif -%}
            </div>
            {%- if block.settings.show_link -%}
              <a class="elix-catalogue__button" href="{{ catalogue_collection.url }}" aria-label="Explore {{ collection_heading | escape }} collection">
                Explore Collection <span aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>

          <ul class="elix-catalogue__products" role="list" aria-label="{{ collection_heading | escape }} products">
            {%- for product in catalogue_collection.products limit: block.settings.product_limit -%}
              <li class="elix-catalogue__product">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'square',
                  image_shape: 'default',
                  show_secondary_image: false,
                  show_vendor: false,
                  show_rating: false,
                  lazy_load: true,
                  skip_styles: false,
                  quick_add: 'none',
                  section_id: section.id,
                  product_view_context: 'collection'
                %}
              </li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}
    {%- endfor -%}
  </div>
</main>

{% schema %}
{
  "name": "ELIX catalogue",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ELIX LABS RESEARCH CATALOGUE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore Our Research Collections" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Discover the ELIX LABS catalogue, organised by research field for clear and efficient navigation." },
    { "type": "checkbox", "id": "show_notice", "label": "Show research notice", "default": true }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Display name" },
        { "type": "textarea", "id": "description", "label": "Short description" },
        {
          "type": "select", "id": "palette", "label": "Palette", "default": "weight",
          "options": [
            { "value": "weight", "label": "Weight" },
            { "value": "recovery", "label": "Recovery" },
            { "value": "muscle", "label": "Muscle" },
            { "value": "cognitive", "label": "Cognitive" },
            { "value": "longevity", "label": "Longevity" },
            { "value": "immune", "label": "Immune" },
            { "value": "tanning", "label": "Tanning" },
            { "value": "hormones", "label": "Hormones" }
          ]
        },
        { "type": "range", "id": "product_limit", "label": "Products shown", "min": 2, "max": 8, "step": 1, "default": 4 },
        { "type": "checkbox", "id": "show_link", "label": "Show collection link", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "ELIX catalogue" }]
}
{% endschema %}
