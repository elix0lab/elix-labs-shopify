{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<section class="elix-lux elix-section"><div class="elix-wrap"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-grid elix-cardgrid">{% for block in section.blocks %}<article class="elix-card elix-info" {{ block.shopify_attributes }}><div>{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p>{% if block.settings.link_label != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_label }} →</a>{% endif %}</article>{% endfor %}</div></div></section><style>.elix-cardgrid{grid-template-columns:repeat(auto-fit,minmax(24rem,1fr));margin-top:4rem}.elix-info{padding:3rem}.elix-info div{font-size:3.8rem}.elix-info h3{color:#fff;font-size:2.3rem}.elix-info p{color:rgba(255,255,255,.67);line-height:1.65}.elix-info a{color:#7DE2FC;font-weight:800;text-decoration:none}</style>{% schema %}{"name":"ELIX premium card grid","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Scientific Standards"},{"type":"text","id":"heading","label":"Heading","default":"Built for rigorous research."}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"text","id":"icon","label":"Icon","default":"🧪"},{"type":"text","id":"title","label":"Title","default":"Pharmaceutical Grade"},{"type":"textarea","id":"text","label":"Text","default":"Premium controls, clear documentation and research-first handling."},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"ELIX premium card grid"}]}{% endschema %}
