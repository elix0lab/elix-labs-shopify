{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<footer class="elix-lux elix-section elix-footer"><div class="elix-wrap elix-footer__grid"><div><h2>{{ section.settings.brand }}</h2><p class="elix-muted">{{ section.settings.text }}</p></div>{% for block in section.blocks %}<nav {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3>{% if block.settings.menu != blank %}{% for link in block.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% endif %}</nav>{% endfor %}</div><div class="elix-wrap elix-footer__bottom"><span>{{ section.settings.copyright }}</span><span>{{ section.settings.social }}</span></div></footer><style>.elix-footer{border-top:1px solid rgba(255,255,255,.12);padding-bottom:3rem}.elix-footer__grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:3rem}.elix-footer h2,.elix-footer h3{color:#fff}.elix-footer a{display:block;color:rgba(255,255,255,.65);text-decoration:none;margin:.8rem 0}.elix-footer__bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:4rem;padding-top:2rem;display:flex;justify-content:space-between;color:rgba(255,255,255,.55)}@media(max-width:800px){.elix-footer__grid{grid-template-columns:1fr}.elix-footer__bottom{display:block}}</style>{% schema %}{"name":"ELIX premium footer","settings":[{"type":"text","id":"brand","label":"Brand","default":"ELIX LABS"},{"type":"textarea","id":"text","label":"Text","default":"Luxury biotechnology ecommerce for research-focused customers."},{"type":"text","id":"copyright","label":"Copyright","default":"© ELIX LABS. All rights reserved."},{"type":"text","id":"social","label":"Social text","default":"Instagram · X · LinkedIn"}],"blocks":[{"type":"menu","name":"Menu column","settings":[{"type":"text","id":"title","label":"Title","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu"}]}],"presets":[{"name":"ELIX premium footer"}]}{% endschema %}
