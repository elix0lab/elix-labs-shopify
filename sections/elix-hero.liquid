{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}
<section class="elix-lux elix-hero elix-hero--{{ section.id }}">
  <div class="elix-hero__particles" aria-hidden="true"></div><div class="elix-wrap elix-hero__grid">
    <div class="elix-hero__copy"><p class="elix-eyebrow">{{ section.settings.eyebrow | escape }}</p><h1 class="elix-title">{{ section.settings.heading | newline_to_br }}</h1><div class="elix-copy">{{ section.settings.text }}</div><div class="elix-hero__actions"><a class="elix-btn" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a><a class="elix-btn elix-btn--ghost" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a></div><div class="elix-hero__badges">{% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.icon }} {{ block.settings.text }}</span>{% endfor %}</div></div>
    <div class="elix-hero__visual"><div class="elix-dna" aria-hidden="true">{% for i in (1..14) %}<i style="--i:{{ i }}"></i>{% endfor %}</div><div class="elix-bottle">{% if section.settings.product_image != blank %}{{ section.settings.product_image | image_url: width: 720 | image_tag: loading: 'eager', widths: '360,540,720', alt: section.settings.heading }}{% else %}<div class="elix-bottle__mock"><b>ELIX</b><span>LABS</span></div>{% endif %}</div></div>
  </div>
</section>
<style>.elix-hero--{{section.id}}{min-height:82rem;display:grid;align-items:center;background:radial-gradient(circle at 70% 20%,rgba(75,117,255,.32),transparent 32%),radial-gradient(circle at 35% 70%,rgba(139,92,246,.24),transparent 34%),#050505}.elix-hero--{{section.id}} .elix-hero__grid{display:grid;grid-template-columns:1.02fr .98fr;gap:4rem;align-items:center;padding:10rem 0}.elix-hero__actions{display:flex;gap:1.2rem;flex-wrap:wrap;margin-top:3.2rem}.elix-hero__badges{display:flex;gap:1rem;flex-wrap:wrap;margin-top:3rem}.elix-hero__badges span{padding:1rem 1.3rem;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:rgba(255,255,255,.06);animation:rise 5s ease-in-out infinite}.elix-hero__visual{position:relative;min-height:58rem}.elix-bottle{position:absolute;inset:8% 8% 0;display:grid;place-items:center;filter:drop-shadow(0 40px 80px rgba(75,117,255,.38))}.elix-bottle img{max-height:58rem;width:auto;max-width:100%;object-fit:contain}.elix-bottle__mock{width:23rem;height:46rem;border-radius:4rem 4rem 2rem 2rem;background:linear-gradient(120deg,#101010,#27273a 44%,#090909);border:1px solid rgba(255,255,255,.2);display:grid;place-items:center;color:#fff;font-size:4rem;letter-spacing:.1em}.elix-bottle__mock span{font-size:1.3rem;color:#7DE2FC}.elix-dna{position:absolute;inset:0;opacity:.75}.elix-dna i{position:absolute;left:50%;top:calc(var(--i)*6%);width:18rem;height:2px;background:linear-gradient(90deg,#4B75FF,#7DE2FC);transform:translateX(-50%) rotate(calc(var(--i)*18deg));box-shadow:0 0 22px #4B75FF;animation:pulse 3s ease-in-out infinite}.elix-dna i:before,.elix-dna i:after{content:"";position:absolute;top:-5px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 0 18px #7DE2FC}.elix-dna i:before{left:0}.elix-dna i:after{right:0}@keyframes pulse{50%{opacity:.35;transform:translateX(-50%) rotate(calc(var(--i)*18deg)) scale(.92)}}@keyframes rise{50%{transform:translateY(-5px)}}@media(max-width:900px){.elix-hero--{{section.id}} .elix-hero__grid{grid-template-columns:1fr}.elix-hero__visual{min-height:42rem}.elix-hero--{{section.id}}{min-height:auto}}</style>
{% schema %}{"name":"ELIX premium hero","tag":"section","class":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ELIX LABS BIOTECH"},{"type":"textarea","id":"heading","label":"Heading","default":"PRECISION PEPTIDES.\nREAL RESULTS."},{"type":"richtext","id":"text","label":"Subtitle","default":"<p>Pharmaceutical-grade research peptides engineered for modern laboratories, transparent protocols and uncompromising quality.</p>"},{"type":"image_picker","id":"product_image","label":"Product bottle image"},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop Peptides"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Browse Categories"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"badge","name":"Trust badge","settings":[{"type":"text","id":"icon","label":"Icon","default":"🧪"},{"type":"text","id":"text","label":"Text","default":"Lab tested"}]}],"presets":[{"name":"ELIX premium hero","blocks":[{"type":"badge","settings":{"icon":"🧪","text":"Lab Tested"}},{"type":"badge","settings":{"icon":"⚡","text":"Fast Dispatch"}},{"type":"badge","settings":{"icon":"💎","text":"High Purity"}}]}]}{% endschema %}
