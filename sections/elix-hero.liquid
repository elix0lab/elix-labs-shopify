{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}

<section class="elix-lux elix-hero elix-hero--{{ section.id }}" aria-labelledby="ElixHeroTitle-{{ section.id }}">
  <div class="elix-hero__lab" aria-hidden="true"></div>
  <div class="elix-hero__mesh" aria-hidden="true"></div>
  <div class="elix-wrap elix-hero__grid">
    <div class="elix-hero__copy">
      <p class="elix-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="ElixHeroTitle-{{ section.id }}" class="elix-title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <div class="elix-copy">{{ section.settings.text }}</div>
      <div class="elix-hero__actions">
        <a class="elix-btn" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>
        <a class="elix-btn elix-btn--ghost elix-btn--glass" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a>
      </div>
      <div class="elix-hero__badges" aria-label="ELIX LABS trust signals">
        {% for block in section.blocks %}
          <span {{ block.shopify_attributes }}><b>{{ block.settings.icon }}</b><em>{{ block.settings.text }}</em></span>
        {% endfor %}
      </div>
    </div>

    <div class="elix-hero__visual" data-elix-parallax>
      <div class="elix-hero__halo" aria-hidden="true"></div>
      <div class="elix-bottle" aria-label="Premium ELIX LABS BPC-157 product presentation">
        {% if section.settings.product_image != blank %}
          {%- assign hero_image_alt = section.settings.product_image.alt | default: 'ELIX LABS BPC-157 bottle and product information card' -%}
          {{ section.settings.product_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '420,640,900,1100,1400', alt: hero_image_alt }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .elix-hero--{{ section.id }}{min-height:86rem;display:grid;align-items:center;background:radial-gradient(circle at 72% 36%,rgba(40,120,255,.18),transparent 34rem),radial-gradient(circle at 12% 72%,rgba(240,32,255,.13),transparent 42rem),linear-gradient(117deg,#02040a 0%,#071224 46%,#05030a 100%);isolation:isolate}
  .elix-hero--{{ section.id }}:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 68% 50%,rgba(102,230,255,.16),transparent 23rem),radial-gradient(circle at 82% 72%,rgba(40,120,255,.2),transparent 34rem),radial-gradient(circle at 18% 80%,rgba(240,32,255,.16),transparent 35rem),linear-gradient(180deg,rgba(255,255,255,.035),transparent 28rem);mix-blend-mode:screen;opacity:.86;pointer-events:none}
  .elix-hero--{{ section.id }}:after{content:"";position:absolute;left:-10%;right:-10%;bottom:-18%;height:42rem;background:radial-gradient(ellipse at 30% 52%,rgba(240,32,255,.42),transparent 38%),radial-gradient(ellipse at 68% 42%,rgba(102,230,255,.38),transparent 42%),linear-gradient(98deg,transparent 7%,rgba(240,32,255,.45) 20%,rgba(102,230,255,.46) 48%,rgba(40,120,255,.48) 72%,transparent 91%);clip-path:polygon(0 62%,9% 50%,19% 57%,30% 47%,43% 56%,55% 43%,69% 49%,82% 34%,100% 42%,100% 76%,88% 69%,73% 82%,58% 71%,43% 79%,27% 68%,12% 78%,0 72%);filter:blur(16px) saturate(145%);opacity:.74;transform:translateZ(0);pointer-events:none}
  .elix-hero__lab{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,4,8,.94),rgba(3,7,18,.66) 42%,rgba(3,4,8,.34)),radial-gradient(ellipse at 74% 58%,rgba(255,255,255,.105),transparent 24rem),radial-gradient(ellipse at 47% 84%,rgba(102,230,255,.14),transparent 42rem);filter:saturate(130%)}
  .elix-hero__lab:before{content:"";position:absolute;right:8%;top:10%;width:36rem;height:58rem;border-radius:50%;border:1px solid rgba(102,230,255,.16);box-shadow:0 0 42px rgba(102,230,255,.12),inset 0 0 38px rgba(139,92,246,.11);filter:blur(2px);opacity:.38;transform:rotate(-18deg)}
  .elix-hero__lab:after{content:"";position:absolute;left:-8%;right:-8%;bottom:5%;height:22rem;background:linear-gradient(100deg,transparent 4%,rgba(240,32,255,.7) 18%,rgba(139,92,246,.38) 34%,rgba(102,230,255,.62) 58%,rgba(40,120,255,.52) 78%,transparent 96%);clip-path:polygon(0 58%,10% 45%,21% 54%,34% 37%,48% 50%,61% 32%,74% 45%,88% 25%,100% 38%,100% 57%,88% 43%,75% 61%,61% 50%,49% 66%,34% 54%,21% 70%,9% 59%,0 72%);filter:blur(10px) saturate(160%);opacity:.72;animation:elix-flow 10s ease-in-out infinite alternate;pointer-events:none}
  .elix-hero__mesh{position:absolute;inset:0;opacity:.55;background-image:radial-gradient(circle at 12% 29%,rgba(240,32,255,.56) 0 .45rem,transparent .52rem),radial-gradient(circle at 86% 18%,rgba(40,120,255,.42) 0 .34rem,transparent .42rem),radial-gradient(circle at 76% 78%,rgba(102,230,255,.5) 0 .38rem,transparent .46rem),linear-gradient(30deg,transparent 0 48%,rgba(102,230,255,.09) 48.2% 48.45%,transparent 48.7%),linear-gradient(150deg,transparent 0 47%,rgba(139,92,246,.08) 47.25% 47.5%,transparent 47.75%);background-size:38rem 32rem,44rem 38rem,35rem 30rem,18rem 18rem,22rem 22rem;mask-image:radial-gradient(circle at 78% 45%,#000,transparent 58%),radial-gradient(circle at 4% 56%,#000,transparent 36%);pointer-events:none}
  .elix-hero--{{ section.id }} .elix-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(36rem,.94fr);gap:clamp(3rem,6vw,7rem);align-items:center;padding:clamp(7rem,9vw,11rem) 0}.elix-hero__copy{max-width:68rem}.elix-hero__actions{display:flex;gap:1.2rem;flex-wrap:wrap;margin-top:3.2rem}
  .elix-hero__badges{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.1rem;margin-top:3.3rem}.elix-hero__badges span{display:flex;align-items:center;gap:.95rem;padding:1.25rem 1.35rem;border:1px solid rgba(102,230,255,.24);border-radius:1.8rem;background:linear-gradient(145deg,rgba(255,255,255,.105),rgba(255,255,255,.035));color:rgba(255,255,255,.84);backdrop-filter:blur(18px);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 16px 42px rgba(0,0,0,.18);transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.elix-hero__badges span:hover{transform:translateY(-3px);border-color:rgba(240,32,255,.42);box-shadow:0 18px 52px rgba(40,120,255,.18)}.elix-hero__badges b{display:grid;place-items:center;width:3.2rem;height:3.2rem;border-radius:50%;background:linear-gradient(135deg,rgba(40,120,255,.25),rgba(240,32,255,.22));color:#66e6ff}.elix-hero__badges em{font-style:normal;font-weight:800;font-size:1.28rem;text-transform:uppercase;letter-spacing:.05em}
  .elix-hero__visual{position:relative;min-height:68rem;display:grid;place-items:center;perspective:1000px}.elix-hero__visual:before{content:"";position:absolute;inset:9% 2% 4%;border-radius:48%;background:radial-gradient(circle at 45% 40%,rgba(102,230,255,.18),transparent 35%),radial-gradient(circle at 66% 48%,rgba(139,92,246,.15),transparent 39%),radial-gradient(ellipse at 52% 50%,rgba(255,255,255,.07),transparent 58%);filter:blur(16px);opacity:.82;transform:translateY(-3rem);pointer-events:none}.elix-hero__halo{position:absolute;width:min(62rem,88vw);aspect-ratio:1;border-radius:50%;background:radial-gradient(circle,rgba(102,230,255,.18),rgba(139,92,246,.095) 39%,transparent 65%);border:1px solid rgba(102,230,255,.22);box-shadow:inset 0 0 85px rgba(139,92,246,.18),0 0 88px rgba(40,120,255,.18);animation:elix-glow 5.5s ease-in-out infinite alternate;transform:translateY(-3rem)}.elix-hero__halo:after{content:"";position:absolute;inset:2rem;border-radius:inherit;border:1px solid rgba(240,32,255,.22);clip-path:polygon(45% 0,100% 0,100% 100%,55% 100%)}
  .elix-bottle{position:relative;z-index:1;display:grid;place-items:center;width:100%;max-width:84rem;transform:translateY(-4rem)}.elix-bottle:after{content:"";position:absolute;bottom:-1.2rem;width:62%;height:2rem;border-radius:50%;background:rgba(2,4,10,.38);filter:blur(14px);z-index:-1;transform:translateY(3.8rem);opacity:.72}.elix-bottle img{display:block;width:100%;height:auto;max-height:80rem;object-fit:contain;filter:drop-shadow(0 2.8rem 3.8rem rgba(0,0,0,.18))}
  @keyframes elix-glow{to{box-shadow:inset 0 0 120px rgba(240,32,255,.2),0 0 135px rgba(102,230,255,.24)}}@keyframes elix-flow{to{transform:translate3d(2.2rem,-1.2rem,0) scale(1.015);opacity:.86}}
  @media(max-width:900px){.elix-hero--{{ section.id }}{min-height:auto}.elix-hero--{{ section.id }} .elix-hero__grid{grid-template-columns:1fr;padding:5.8rem 0}.elix-hero__badges{grid-template-columns:1fr}.elix-hero__visual{min-height:52rem}.elix-hero__visual:before{inset:6% 5% 8%;transform:translateY(-1.8rem)}.elix-hero__halo{width:min(58rem,92vw);transform:translateY(-1.8rem)}.elix-bottle{max-width:70rem;transform:translateY(-2.4rem)}.elix-bottle img{max-height:52rem}}
  @media(max-width:560px){.elix-hero__visual{min-height:39rem}.elix-hero__visual:before{filter:blur(12px);opacity:.72}.elix-hero__halo{width:min(42rem,92vw)}.elix-bottle{max-width:46rem;transform:translateY(-1.4rem)}.elix-bottle:after{width:58%;height:1.5rem;filter:blur(12px);transform:translateY(2.4rem)}.elix-bottle img{max-height:38rem}}
  @media(prefers-reduced-motion:reduce){.elix-hero__halo,.elix-hero__lab:after{animation:none}}
</style>

{% schema %}
{"name":"ELIX premium hero","tag":"section","class":"section","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ELIX LABS BIOTECH"},{"type":"textarea","id":"heading","label":"Heading","default":"PRECISION PEPTIDES.\nREAL RESULTS."},{"type":"richtext","id":"text","label":"Subtitle","default":"<p>Pharmaceutical-grade research peptides engineered for modern laboratories, transparent protocols and uncompromising quality.</p>"},{"type":"image_picker","id":"product_image","label":"Official ELIX LABS bottle render","info":"Select the uploaded official product photography. The hero uses this image directly and does not recreate it with CSS or SVG."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop Peptides"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Browse Categories"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"badge","name":"Trust badge","settings":[{"type":"text","id":"icon","label":"Icon","default":"🧪"},{"type":"text","id":"text","label":"Text","default":"Lab tested"}]}],"presets":[{"name":"ELIX premium hero","blocks":[{"type":"badge","settings":{"icon":"🧪","text":"Lab Tested"}},{"type":"badge","settings":{"icon":"⚡","text":"Fast Dispatch"}},{"type":"badge","settings":{"icon":"💎","text":"High Purity"}}]}]}
{% endschema %}
