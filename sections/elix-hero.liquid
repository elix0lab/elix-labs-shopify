{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}

{% if section.settings.background_image != blank %}
  <link rel="preload" as="image" href="{{ section.settings.background_image | image_url: width: 2400 }}" fetchpriority="high">
{% endif %}

<section
  class="elix-lux elix-hero elix-hero--{{ section.id }}{% if section.settings.background_image != blank %} elix-hero--has-background{% endif %}"
  {% if section.settings.background_image != blank %}style="--elix-hero-background: url('{{ section.settings.background_image | image_url: width: 2400 }}'); --elix-hero-position-desktop: {{ section.settings.background_position_desktop }}; --elix-hero-position-mobile: {{ section.settings.background_position_mobile }}; --elix-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"{% endif %}
  aria-labelledby="ElixHeroTitle-{{ section.id }}"
>
  {% if section.settings.background_image != blank %}<div class="elix-hero__background" aria-hidden="true"></div>{% endif %}
  <div class="elix-wrap elix-hero__grid">
    <div class="elix-hero__copy">
      <p class="elix-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="ElixHeroTitle-{{ section.id }}" class="elix-title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <div class="elix-copy">{{ section.settings.text }}</div>
      <div class="elix-hero__actions">
        <a class="elix-btn" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>
        <a class="elix-btn elix-btn--ghost elix-btn--glass" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a>
      </div>
      <div class="elix-hero__badges" aria-label="ELIX LABS trust signals">
        {% for block in section.blocks %}
          <span {{ block.shopify_attributes }}><b>{{ block.settings.icon }}</b><em>{{ block.settings.text }}</em></span>
        {% endfor %}
      </div>
    </div>

    <div class="elix-hero__visual" data-elix-parallax>
      <div class="elix-bottle" aria-label="Premium ELIX LABS BPC-157 product presentation">
        {% if section.settings.product_image != blank %}
          {%- assign hero_image_alt = section.settings.product_image.alt | default: 'ELIX LABS BPC-157 bottle and product information card' -%}
          {{ section.settings.product_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '420,640,900,1100,1400', alt: hero_image_alt }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .elix-hero--{{ section.id }}{--elix-hero-parallax:0px;min-height:86rem;display:grid;align-items:center;position:relative;overflow:hidden;background-color:#02040a;isolation:isolate}
  .elix-hero--{{ section.id }} .elix-hero__background{position:absolute;inset:-3%;z-index:-2;background-image:var(--elix-hero-background);background-size:cover;background-position:var(--elix-hero-position-desktop);background-repeat:no-repeat;transform:translate3d(0,var(--elix-hero-parallax),0) scale(1);transform-origin:center;will-change:transform;animation:elix-hero-breathe-{{ section.id }} 30s ease-in-out infinite alternate}
  .elix-hero--{{ section.id }}.elix-hero--has-background:before{content:"";position:absolute;inset:0;z-index:-1;background:rgba(2,4,10,var(--elix-hero-overlay-opacity));pointer-events:none}
  .elix-hero--{{ section.id }} .elix-hero__grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) minmax(36rem,.94fr);gap:clamp(3rem,6vw,7rem);align-items:center;padding:clamp(7rem,9vw,11rem) 0}.elix-hero__copy{max-width:68rem}.elix-hero__actions{display:flex;gap:1.2rem;flex-wrap:wrap;margin-top:3.2rem}
  .elix-hero__badges{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.1rem;margin-top:3.3rem}.elix-hero__badges span{display:flex;align-items:center;gap:.95rem;padding:1.25rem 1.35rem;border:1px solid rgba(102,230,255,.24);border-radius:1.8rem;background:linear-gradient(145deg,rgba(255,255,255,.105),rgba(255,255,255,.035));color:rgba(255,255,255,.84);backdrop-filter:blur(18px);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 16px 42px rgba(0,0,0,.18);transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.elix-hero__badges span:hover{transform:translateY(-3px);border-color:rgba(240,32,255,.42);box-shadow:0 18px 52px rgba(40,120,255,.18)}.elix-hero__badges b{display:grid;place-items:center;width:3.2rem;height:3.2rem;border-radius:50%;background:linear-gradient(135deg,rgba(40,120,255,.25),rgba(240,32,255,.22));color:#66e6ff}.elix-hero__badges em{font-style:normal;font-weight:800;font-size:1.28rem;text-transform:uppercase;letter-spacing:.05em}
  .elix-hero__visual{position:relative;min-height:68rem;display:grid;place-items:center;perspective:1000px}
  .elix-bottle{position:relative;z-index:1;display:grid;place-items:center;width:100%;max-width:84rem;transform:translateY(-4rem)}.elix-bottle:after{content:"";position:absolute;bottom:-1.2rem;width:62%;height:2rem;border-radius:50%;background:rgba(2,4,10,.38);filter:blur(14px);z-index:-1;transform:translateY(3.8rem);opacity:.72}.elix-bottle img{display:block;width:100%;height:auto;max-height:80rem;object-fit:contain;filter:drop-shadow(0 2.8rem 3.8rem rgba(0,0,0,.18))}
  @keyframes elix-hero-breathe-{{ section.id }}{from{transform:translate3d(0,var(--elix-hero-parallax),0) scale(1)}to{transform:translate3d(0,var(--elix-hero-parallax),0) scale(1.03)}}
  @media(max-width:900px){.elix-hero--{{ section.id }}{min-height:auto}.elix-hero--{{ section.id }} .elix-hero__background{background-position:var(--elix-hero-position-mobile)}.elix-hero--{{ section.id }} .elix-hero__grid{grid-template-columns:1fr;padding:5.8rem 0}.elix-hero__badges{grid-template-columns:1fr}.elix-hero__visual{min-height:52rem}.elix-bottle{max-width:70rem;transform:translateY(-2.4rem)}.elix-bottle img{max-height:52rem}}
  @media(max-width:560px){.elix-hero__visual{min-height:39rem}.elix-bottle{max-width:46rem;transform:translateY(-1.4rem)}.elix-bottle:after{width:58%;height:1.5rem;filter:blur(12px);transform:translateY(2.4rem)}.elix-bottle img{max-height:38rem}}
  @media(prefers-reduced-motion:reduce){.elix-hero--{{ section.id }} .elix-hero__background{animation:none;will-change:auto}}
</style>

<script>
  (() => {
    const hero = document.querySelector('.elix-hero--{{ section.id }}');
    if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let frame;
    const updateBackground = () => {
      const offset = Math.max(-24, Math.min(24, hero.getBoundingClientRect().top * -0.06));
      hero.style.setProperty('--elix-hero-parallax', `${offset}px`);
      frame = null;
    };
    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateBackground);
    };

    updateBackground();
    window.addEventListener('scroll', requestUpdate, { passive: true });
  })();
</script>

{% schema %}
