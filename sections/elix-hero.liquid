<section class="elix-hero elix-hero--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width elix-hero__inner">
    <p class="elix-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <div class="elix-hero__text rte">{{ section.settings.text }}</div>
    <div class="elix-hero__actions">
      {% if section.settings.primary_label != blank %}
        <a class="button" {% if section.settings.primary_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.primary_link }}"{% endif %}>{{ section.settings.primary_label | escape }}</a>
      {% endif %}
      {% if section.settings.secondary_label != blank %}
        <a class="button button--secondary" {% if section.settings.secondary_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.secondary_link }}"{% endif %}>{{ section.settings.secondary_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .elix-hero--{{ section.id }} { background: #07120f; color: #f5f2eb; }
  .elix-hero--{{ section.id }} .elix-hero__inner { min-height: 68rem; display: grid; align-content: center; padding-top: 8rem; padding-bottom: 8rem; }
  .elix-hero--{{ section.id }} .elix-hero__eyebrow { color: #b8d6c7; font-weight: 700; letter-spacing: .18em; margin: 0 0 1.6rem; text-transform: uppercase; }
  .elix-hero--{{ section.id }} h1 { color: inherit; font-size: clamp(4.2rem, 8vw, 9.6rem); line-height: .92; max-width: 11ch; margin: 0; }
  .elix-hero--{{ section.id }} .elix-hero__text { color: #dfe8e1; font-size: 2rem; max-width: 64rem; margin: 2.4rem 0 0; }
  .elix-hero--{{ section.id }} .elix-hero__actions { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 3.2rem; }
</style>

{% schema %}
{
  "name": "ELIX hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ELIX LABS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Research peptides for focused discovery." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explore rigorously sourced peptides, clear documentation, and lab-first resources built for modern research teams.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop peptides" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Our standards" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "ELIX hero" }]
}
{% endschema %}
