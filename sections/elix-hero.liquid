{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}

{% if section.settings.background_image != blank %}
  <link rel="preload" as="image" href="{{ section.settings.background_image | image_url: width: 2400 }}" fetchpriority="high">
{% endif %}

<section
  class="elix-lux elix-hero elix-hero--{{ section.id }}"
  {% if section.settings.background_image != blank %}style="--elix-hero-background: url('{{ section.settings.background_image | image_url: width: 2400 }}')"{% endif %}
  aria-labelledby="ElixHeroTitle-{{ section.id }}"
>
  <div class="elix-wrap elix-hero__grid">
    <div class="elix-hero__copy">
      <p class="elix-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 id="ElixHeroTitle-{{ section.id }}" class="elix-title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      <div class="elix-copy">{{ section.settings.text }}</div>
      <div class="elix-hero__actions">
        <a class="elix-btn" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">→</span></a>
        <a class="elix-btn elix-btn--ghost elix-btn--glass" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a>
      </div>
      <div class="elix-hero__badges" aria-label="ELIX LABS trust signals">
        {% for block in section.blocks %}
          <span {{ block.shopify_attributes }}><b>{{ block.settings.icon }}</b><em>{{ block.settings.text }}</em></span>
        {% endfor %}
      </div>
    </div>

    <div class="elix-hero__visual" data-elix-parallax>
      <div class="elix-bottle" aria-label="Premium ELIX LABS BPC-157 product presentation">
        {% if section.settings.product_image != blank %}
          {%- assign hero_image_alt = section.settings.product_image.alt | default: 'ELIX LABS BPC-157 bottle and product information card' -%}
          {{ section.settings.product_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '420,640,900,1100,1400', alt: hero_image_alt }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .elix-hero--{{ section.id }}{min-height:86rem;display:grid;align-items:center;background-color:#02040a;background-image:var(--elix-hero-background);background-size:cover;background-position:center;background-repeat:no-repeat;isolation:isolate}
  .elix-hero--{{ section.id }}:before{content:"";position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,rgba(2,4,10,.92) 0%,rgba(2,4,10,.86) 58%,rgba(2,4,10,.08) 82%,rgba(2,4,10,.2) 100%),linear-gradient(90deg,rgba(2,4,10,.62) 0%,rgba(2,4,10,.5) 42%,rgba(2,4,10,.34) 68%,rgba(2,4,10,.42) 100%);pointer-events:none}
  .elix-hero--{{ section.id }} .elix-hero__grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(36rem,.94fr);gap:clamp(3rem,6vw,7rem);align-items:center;padding:clamp(7rem,9vw,11rem) 0}.elix-hero__copy{max-width:68rem}.elix-hero__actions{display:flex;gap:1.2rem;flex-wrap:wrap;margin-top:3.2rem}
  .elix-hero__badges{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.1rem;margin-top:3.3rem}.elix-hero__badges span{display:flex;align-items:center;gap:.95rem;padding:1.25rem 1.35rem;border:1px solid rgba(102,230,255,.24);border-radius:1.8rem;background:linear-gradient(145deg,rgba(255,255,255,.105),rgba(255,255,255,.035));color:rgba(255,255,255,.84);backdrop-filter:blur(18px);box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 16px 42px rgba(0,0,0,.18);transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}.elix-hero__badges span:hover{transform:translateY(-3px);border-color:rgba(240,32,255,.42);box-shadow:0 18px 52px rgba(40,120,255,.18)}.elix-hero__badges b{display:grid;place-items:center;width:3.2rem;height:3.2rem;border-radius:50%;background:linear-gradient(135deg,rgba(40,120,255,.25),rgba(240,32,255,.22));color:#66e6ff}.elix-hero__badges em{font-style:normal;font-weight:800;font-size:1.28rem;text-transform:uppercase;letter-spacing:.05em}
  .elix-hero__visual{position:relative;min-height:68rem;display:grid;place-items:center;perspective:1000px}
  .elix-bottle{position:relative;z-index:1;display:grid;place-items:center;width:100%;max-width:84rem;transform:translateY(-4rem)}.elix-bottle:after{content:"";position:absolute;bottom:-1.2rem;width:62%;height:2rem;border-radius:50%;background:rgba(2,4,10,.38);filter:blur(14px);z-index:-1;transform:translateY(3.8rem);opacity:.72}.elix-bottle img{display:block;width:100%;height:auto;max-height:80rem;object-fit:contain;filter:drop-shadow(0 2.8rem 3.8rem rgba(0,0,0,.18))}
  @media(max-width:900px){.elix-hero--{{ section.id }}{min-height:auto;background-position:58% center}.elix-hero--{{ section.id }}:before{background:linear-gradient(180deg,rgba(2,4,10,.84) 0%,rgba(2,4,10,.64) 48%,rgba(2,4,10,.3) 74%,rgba(2,4,10,.42) 100%)}.elix-hero--{{ section.id }} .elix-hero__grid{grid-template-columns:1fr;padding:5.8rem 0}.elix-hero__badges{grid-template-columns:1fr}.elix-hero__visual{min-height:52rem}.elix-bottle{max-width:70rem;transform:translateY(-2.4rem)}.elix-bottle img{max-height:52rem}}
  @media(max-width:560px){.elix-hero--{{ section.id }}{background-position:67% center}.elix-hero--{{ section.id }}:before{background:linear-gradient(180deg,rgba(2,4,10,.9) 0%,rgba(2,4,10,.72) 49%,rgba(2,4,10,.4) 72%,rgba(2,4,10,.56) 100%)}.elix-hero__visual{min-height:39rem}.elix-bottle{max-width:46rem;transform:translateY(-1.4rem)}.elix-bottle:after{width:58%;height:1.5rem;filter:blur(12px);transform:translateY(2.4rem)}.elix-bottle img{max-height:38rem}}
</style>

{% schema %}
{"name":"ELIX premium hero","tag":"section","class":"section","settings":[{"type":"image_picker","id":"background_image","label":"Hero background artwork","info":"Select the supplied blue and violet molecular target artwork."},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"ELIX LABS BIOTECH"},{"type":"textarea","id":"heading","label":"Heading","default":"PRECISION PEPTIDES.\nREAL RESULTS."},{"type":"richtext","id":"text","label":"Subtitle","default":"<p>Pharmaceutical-grade research peptides engineered for modern laboratories, transparent protocols and uncompromising quality.</p>"},{"type":"image_picker","id":"product_image","label":"Official ELIX LABS bottle render","info":"Select the uploaded official product photography. The hero uses this image directly and does not recreate it with CSS or SVG."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop Peptides"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Browse Categories"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"blocks":[{"type":"badge","name":"Trust badge","settings":[{"type":"text","id":"icon","label":"Icon","default":"🧪"},{"type":"text","id":"text","label":"Text","default":"Lab tested"}]}],"presets":[{"name":"ELIX premium hero","blocks":[{"type":"badge","settings":{"icon":"🧪","text":"Lab Tested"}},{"type":"badge","settings":{"icon":"⚡","text":"Fast Dispatch"}},{"type":"badge","settings":{"icon":"💎","text":"High Purity"}}]}]}
{% endschema %}
