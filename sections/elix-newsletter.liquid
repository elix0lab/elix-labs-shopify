{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<section class="elix-lux elix-section"><div class="elix-wrap elix-news elix-card"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-copy">{{ section.settings.text }}</div>{% form 'customer', class: 'elix-news__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required><button class="elix-btn" type="submit">{{ section.settings.button_label }}</button>{% endform %}</div></section><style>.elix-news{padding:clamp(3rem,6vw,7rem);text-align:center;background:radial-gradient(circle at 20% 10%,rgba(125,226,252,.25),transparent 35%),linear-gradient(135deg,rgba(75,117,255,.22),rgba(139,92,246,.18))}.elix-news__form{display:flex;gap:1rem;max-width:64rem;margin:3rem auto 0}.elix-news__form input{flex:1;border-radius:999px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.08);color:#fff;padding:0 2rem}@media(max-width:640px){.elix-news__form{flex-direction:column}.elix-news__form input{min-height:5.2rem}}</style>{% schema %}{"name":"ELIX luxury newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Research access"},{"type":"text","id":"heading","label":"Heading","default":"Join the ELIX LABS intelligence list."},{"type":"richtext","id":"text","label":"Text","default":"<p>Receive new drops, quality notes and private launch updates.</p>"},{"type":"text","id":"placeholder","label":"Placeholder","default":"Email address"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"}],"presets":[{"name":"ELIX luxury newsletter"}]}{% endschema %}
