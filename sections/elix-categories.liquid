{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}
<section class="elix-lux elix-section elix-categories--{{ section.id }}"><div class="elix-wrap"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-grid elix-cat-grid">{% for block in section.blocks %}{% assign link = block.settings.button_link %}{% if block.settings.collection != blank %}{% assign link = block.settings.collection.url %}{% endif %}<article class="elix-card elix-cat" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,600', class: 'elix-cat__image' }}{% endif %}<div class="elix-cat__icon">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><a class="elix-btn elix-btn--ghost" href="{{ link | default: routes.collections_url }}">{{ block.settings.button_label }}</a></article>{% endfor %}</div></div></section>
<style>.elix-cat-grid{grid-template-columns:repeat(4,1fr);margin-top:4rem}.elix-cat{padding:2.6rem;min-height:31rem;display:flex;flex-direction:column}.elix-cat__image{width:100%;height:12rem;object-fit:cover;border-radius:1.8rem;margin-bottom:1.6rem}.elix-cat__icon{font-size:4rem;filter:drop-shadow(0 0 18px rgba(125,226,252,.5))}.elix-cat h3{color:#fff;font-size:2.2rem;margin:1.4rem 0 .8rem}.elix-cat p{color:rgba(255,255,255,.68);line-height:1.55;margin:0 0 2rem}.elix-cat .elix-btn{margin-top:auto;min-height:4.4rem}@media(max-width:990px){.elix-cat-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.elix-cat-grid{grid-template-columns:1fr}}</style>
{% schema %}{"name":"ELIX category explorer","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Research Category Explorer"},{"type":"text","id":"heading","label":"Heading","default":"Explore by protocol objective."}],"blocks":[{"type":"category","name":"Category card","settings":[{"type":"text","id":"icon","label":"Emoji or icon","default":"⚖️"},{"type":"text","id":"title","label":"Title","default":"Weight Management"},{"type":"textarea","id":"text","label":"Description","default":"GLP-1 agonists, metabolic health and fat loss peptides."},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"button_label","label":"Button label","default":"Explore"},{"type":"url","id":"button_link","label":"Fallback button link"}]}],"presets":[{"name":"ELIX category explorer"}]}{% endschema %}
