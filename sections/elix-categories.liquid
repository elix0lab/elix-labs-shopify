<section class="elix-categories elix-categories--{{ section.id }} page-width">
  <div class="elix-categories__header">
    <p class="elix-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="elix-categories__grid">
    {% for block in section.blocks %}
      <a class="elix-categories__card" {% if block.settings.link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.link }}"{% endif %} {{ block.shopify_attributes }}>
        <span>{{ block.settings.title | escape }}</span>
        <p>{{ block.settings.text | escape }}</p>
      </a>
    {% endfor %}
  </div>
</section>
<style>
  .elix-categories--{{ section.id }} { padding-top: 7rem; padding-bottom: 7rem; }
  .elix-categories--{{ section.id }} .elix-categories__header { max-width: 72rem; margin-bottom: 3rem; }
  .elix-categories--{{ section.id }} .elix-categories__eyebrow { color: #4b7560; font-weight: 700; letter-spacing: .18em; margin: 0 0 1.6rem; text-transform: uppercase; }
  .elix-categories--{{ section.id }} h2 { font-size: clamp(3rem, 5vw, 5.6rem); margin: 0; }
  .elix-categories--{{ section.id }} .elix-categories__grid { display: grid; gap: 1.6rem; grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr)); }
  .elix-categories--{{ section.id }} .elix-categories__card { border: .1rem solid rgba(var(--color-foreground), .14); border-radius: 2rem; padding: 2.4rem; color: rgb(var(--color-foreground)); text-decoration: none; background: rgba(var(--color-foreground), .03); }
  .elix-categories--{{ section.id }} .elix-categories__card span { display: block; font-size: 2.2rem; font-weight: 700; margin-bottom: 1rem; }
  .elix-categories--{{ section.id }} .elix-categories__card p { margin: 0; }
</style>
{% schema %}
{
  "name": "ELIX categories",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right peptide for your protocol." }
  ],
  "blocks": [{ "type": "category", "name": "Category", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Research peptides" },
    { "type": "text", "id": "text", "label": "Text", "default": "High-purity compounds for in-vitro research applications." },
    { "type": "url", "id": "link", "label": "Link" }
  ]}],
  "presets": [{ "name": "ELIX categories" }]
}
{% endschema %}
