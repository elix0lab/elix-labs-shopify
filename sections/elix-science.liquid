<section class="elix-science elix-science--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width elix-science__grid">
    <div>
      <p class="elix-science__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>
<style>
  .elix-science--{{ section.id }} { background: #edf5ef; }
  .elix-science--{{ section.id }} .elix-science__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 4rem; padding-top: 7rem; padding-bottom: 7rem; align-items: start; }
  .elix-science--{{ section.id }} .elix-science__eyebrow { color: #4b7560; font-weight: 700; letter-spacing: .18em; margin: 0 0 1.6rem; text-transform: uppercase; }
  .elix-science--{{ section.id }} h2 { font-size: clamp(3rem, 5vw, 5.6rem); margin: 0; }
  @media screen and (max-width: 749px) { .elix-science--{{ section.id }} .elix-science__grid { grid-template-columns: 1fr; } }
</style>
{% schema %}
{
  "name": "ELIX science",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Science-led standards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Documentation and quality controls for confident research." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>ELIX LABS centers every product page around clear specifications, transparent handling guidance, and research-use context so your team can evaluate materials quickly.</p><p>Our catalog is built for qualified laboratory research only and is not intended for human consumption.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "ELIX science" }]
}
{% endschema %}
