{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}<section class="elix-lux elix-section elix-science2"><div class="elix-wrap elix-split"><div class="elix-lab elix-card">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading:'lazy', widths:'500,1000' }}{% else %}<div class="elix-lab__dna">🧬</div>{% endif %}</div><div><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2><div class="elix-copy">{{ section.settings.text }}</div><div class="elix-stats">{% for block in section.blocks %}<div><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></div>{% endfor %}</div></div></div></section><style>.elix-split{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.elix-lab{min-height:52rem;display:grid;place-items:center}.elix-lab img{width:100%;height:100%;object-fit:cover}.elix-lab__dna{font-size:16rem;filter:drop-shadow(0 0 60px #4B75FF)}.elix-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem;margin-top:3rem}.elix-stats div{padding:1.6rem;border-radius:1.8rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12)}.elix-stats strong{display:block;color:#fff;font-size:3rem}.elix-stats span{color:#7DE2FC}@media(max-width:900px){.elix-split{grid-template-columns:1fr}.elix-stats{grid-template-columns:repeat(2,1fr)}}</style>{% schema %}{"name":"ELIX science innovation","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Science & Innovation"},{"type":"text","id":"heading","label":"Heading","default":"Designed for precision-driven laboratories."},{"type":"richtext","id":"text","label":"Text","default":"<p>ELIX LABS combines premium sourcing, modern quality control and research-use transparency across every peptide experience.</p>"},{"type":"image_picker","id":"image","label":"Laboratory image"}],"blocks":[{"type":"stat","name":"Statistic","settings":[{"type":"text","id":"value","label":"Value","default":"99.8%"},{"type":"text","id":"label","label":"Label","default":"Purity"}]}],"presets":[{"name":"ELIX science innovation"}]}{% endschema %}
