{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="elix-lux elix-section elix-products--{{ section.id }}" aria-labelledby="ElixProductsTitle-{{ section.id }}">
  <div class="elix-wrap">
    <div class="elix-products__header">
      <div>
        <p class="elix-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 id="ElixProductsTitle-{{ section.id }}" class="elix-title">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.view_all_label != blank %}
        <a class="elix-products__view" href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}">{{ section.settings.view_all_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>

    {% assign products = section.settings.collection.products | default: collections.all.products %}
    <div class="elix-products" role="list">
      {% for product in products limit: section.settings.products_to_show %}
        <article class="elix-card elix-product" role="listitem">
          <div class="elix-product__topline">
            <span>{{ section.settings.badge_1 | escape }}</span>
            <span>{{ section.settings.badge_2 | escape }}</span>
          </div>
          <a class="elix-product__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_media %}
              {%- assign product_image_alt = product.featured_media.alt | default: product.title -%}
              {{ product.featured_media | image_url: width: 720 | image_tag: loading: 'lazy', widths: '320,520,720', alt: product_image_alt }}
            {% else %}
              <div class="elix-product__vial" aria-hidden="true"><b>{{ product.title | slice: 0, 3 }}</b></div>
            {% endif %}
          </a>
          <div class="elix-product__info">
            <p>{{ section.settings.microcopy | escape }}</p>
            <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {% render 'price', product: product, price_class: '', show_compare_at_price: true %}
            <product-form data-section-id="{{ section.id }}">
              {% form 'product', product %}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="elix-btn" type="submit" {% unless product.available %}disabled{% endunless %}>{{ section.settings.quick_add_label | escape }}</button>
              {% endform %}
            </product-form>
          </div>
        </article>
      {% else %}
        <p class="elix-copy">{{ section.settings.empty_text | escape }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .elix-products__header{display:flex;align-items:end;justify-content:space-between;gap:2rem}.elix-products__view{color:#fff;text-decoration:none;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.elix-products{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(25rem,1fr);gap:2rem;overflow-x:auto;padding:4rem .4rem 2rem;scroll-snap-type:x mandatory;scrollbar-width:thin}.elix-product{scroll-snap-align:start;padding:1.4rem;background:linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.045)),radial-gradient(circle at 50% 0,rgba(102,230,255,.18),transparent 48%)}.elix-product__topline{position:absolute;z-index:2;top:1.8rem;left:1.8rem;right:1.8rem;display:flex;justify-content:space-between;gap:.8rem}.elix-product__topline span{padding:.65rem .9rem;border:1px solid rgba(255,255,255,.15);border-radius:999px;background:rgba(3,4,8,.62);color:rgba(255,255,255,.78);font-size:1.1rem;font-weight:800;text-transform:uppercase;backdrop-filter:blur(14px)}.elix-product__media{display:grid;place-items:center;min-height:30rem;padding:3.8rem 1rem 1rem;border-radius:2rem;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.025));text-decoration:none}.elix-product__media img{width:100%;height:28rem;object-fit:contain;filter:drop-shadow(0 22px 28px rgba(40,120,255,.25));transition:transform .32s ease,filter .32s ease}.elix-product:hover .elix-product__media img{transform:translateY(-5px) scale(1.035);filter:drop-shadow(0 28px 34px rgba(139,92,246,.32))}.elix-product__vial{width:11rem;height:23rem;border-radius:2.6rem 2.6rem 1.4rem 1.4rem;border:1px solid rgba(255,255,255,.22);display:grid;place-items:center;background:#050505;color:#fff}.elix-product__info{padding:1.6rem .4rem .4rem}.elix-product__info p{margin:0 0 .6rem;color:#66e6ff;font-size:1.1rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.elix-product__info h3{margin:.2rem 0 1rem;font-size:2rem;letter-spacing:-.03em}.elix-product__info a{color:#fff;text-decoration:none}.elix-product .price{color:#fff;margin-bottom:1.4rem}.elix-product .price *{color:inherit}.elix-product .elix-btn{width:100%;min-height:4.8rem}.elix-product .shopify-product-form{margin:0}@media(max-width:749px){.elix-products__header{display:block}.elix-products{grid-auto-columns:82%;gap:1.4rem;padding-top:2.6rem}.elix-product__media{min-height:25rem}.elix-product__media img{height:23rem}}
</style>

{% schema %}
{"name":"ELIX featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured Products"},{"type":"text","id":"heading","label":"Heading","default":"High-demand research peptides."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":1,"default":8},{"type":"text","id":"badge_1","label":"Left product badge","default":"Research Use"},{"type":"text","id":"badge_2","label":"Right product badge","default":"99%+ Purity"},{"type":"text","id":"microcopy","label":"Product microcopy","default":"Precision peptide"},{"type":"text","id":"quick_add_label","label":"Quick add label","default":"Quick Add"},{"type":"text","id":"view_all_label","label":"View all label","default":"View all products"},{"type":"url","id":"view_all_link","label":"View all link"},{"type":"text","id":"empty_text","label":"Empty text","default":"Featured products will appear here once available."}],"presets":[{"name":"ELIX featured products"}]}
{% endschema %}
