{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="elix-featured-peptides elix-featured-peptides--{{ section.id }} page-width">
  <div class="elix-featured-peptides__header">
    <p class="elix-featured-peptides__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  {% if section.settings.collection != blank %}
    {% assign elix_products = section.settings.collection.products %}
  {% else %}
    {% assign elix_products = collections.all.products %}
  {% endif %}
  {% if elix_products.size > 0 %}
    <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
      {% for product in elix_products limit: section.settings.products_to_show %}
        <li class="grid__item">{% render 'card-product', card_product: product, media_aspect_ratio: 'adapt', image_shape: 'default', show_secondary_image: true, show_vendor: false, show_rating: false, lazy_load: true, quick_add: 'none', section_id: section.id %}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p>{{ section.settings.empty_text | escape }}</p>
  {% endif %}
  {% if section.settings.button_label != blank %}
    <div class="center"><a class="button" {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}>{{ section.settings.button_label | escape }}</a></div>
  {% endif %}
</section>
<style>
  .elix-featured-peptides--{{ section.id }} { padding-top: 7rem; padding-bottom: 7rem; }
  .elix-featured-peptides--{{ section.id }} .elix-featured-peptides__header { max-width: 72rem; margin-bottom: 3rem; }
  .elix-featured-peptides--{{ section.id }} h2 { font-size: clamp(3rem, 5vw, 5.6rem); margin: 0; }
  .elix-featured-peptides--{{ section.id }} .elix-featured-peptides__eyebrow { color: #4b7560; font-weight: 700; letter-spacing: .18em; margin: 0 0 1.6rem; text-transform: uppercase; }
</style>
{% schema %}
{
  "name": "ELIX featured peptides",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured peptides" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular selections from ELIX LABS." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "empty_text", "label": "Empty collection text", "default": "Featured peptides will appear here once products are available." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all peptides" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "ELIX featured peptides" }]
}
{% endschema %}
