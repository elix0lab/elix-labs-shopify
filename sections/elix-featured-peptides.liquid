{{ 'elix-luxury.css' | asset_url | stylesheet_tag }}{{ 'component-price.css' | asset_url | stylesheet_tag }}
<section class="elix-lux elix-section elix-products--{{ section.id }}"><div class="elix-wrap"><p class="elix-eyebrow">{{ section.settings.eyebrow }}</p><h2 class="elix-title">{{ section.settings.heading }}</h2>{% assign products = section.settings.collection.products | default: collections.all.products %}<div class="elix-products">{% for product in products limit: section.settings.products_to_show %}<article class="elix-card elix-product"><div class="elix-product__badges"><span>{{ section.settings.badge_1 }}</span><button aria-label="Add to wishlist">♡</button></div><a href="{{ product.url }}">{% if product.featured_media %}{{ product.featured_media | image_url: width: 700 | image_tag: loading:'lazy', widths:'350,700' }}{% endif %}<h3>{{ product.title }}</h3></a>{% render 'price', product: product, price_class: '', show_compare_at_price: true %}<product-form data-section-id="{{ section.id }}">{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="elix-btn" type="submit" {% unless product.available %}disabled{% endunless %}>{{ section.settings.quick_add_label }}</button>{% endform %}</product-form></article>{% else %}<p class="elix-copy">{{ section.settings.empty_text }}</p>{% endfor %}</div></div></section><style>.elix-products{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(25rem,1fr);gap:2rem;overflow-x:auto;padding:4rem .4rem 2rem;scroll-snap-type:x mandatory}.elix-product{padding:1.6rem;scroll-snap-align:start}.elix-product img{width:100%;height:28rem;object-fit:contain;border-radius:2rem;background:rgba(255,255,255,.04)}.elix-product a{text-decoration:none;color:#fff}.elix-product h3{font-size:2rem;color:#fff}.elix-product__badges{display:flex;justify-content:space-between;position:absolute;z-index:2;left:2.4rem;right:2.4rem;top:2.4rem}.elix-product__badges span,.elix-product__badges button{border:1px solid rgba(255,255,255,.16);background:rgba(5,5,5,.5);color:#fff;border-radius:999px;padding:.8rem 1rem;backdrop-filter:blur(10px)}.elix-product .elix-btn{width:100%;margin-top:1rem}</style>
{% schema %}{"name":"ELIX featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured Products"},{"type":"text","id":"heading","label":"Heading","default":"High-demand research peptides."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":4,"max":12,"step":1,"default":8},{"type":"text","id":"badge_1","label":"Product badge","default":"🔥 Bestseller"},{"type":"text","id":"quick_add_label","label":"Quick add label","default":"Quick Add"},{"type":"text","id":"empty_text","label":"Empty text","default":"Featured products will appear here once available."}],"presets":[{"name":"ELIX featured products"}]}{% endschema %}
